---
import { WHATSAPP_DISPLAY_NUMBER, whatsappLink } from "../config/contact";

interface Props {
  /** Override the pre-filled inquiry message for a specific page. */
  message?: string;
}
const { message } = Astro.props;
const href = whatsappLink(message);
const label = `Chat with us on WhatsApp at ${WHATSAPP_DISPLAY_NUMBER}`;
---

<a class="wa-float" href={href} target="_blank" rel="noopener noreferrer" aria-label={label} title="Chat with us on WhatsApp">
  <svg class="wa-float__icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16.02 3.2C8.96 3.2 3.22 8.94 3.22 16c0 2.26.6 4.47 1.73 6.42L3.2 28.8l6.54-1.71a12.75 12.75 0 0 0 6.28 1.63h.01c7.05 0 12.79-5.74 12.79-12.8 0-3.42-1.33-6.63-3.75-9.05a12.7 12.7 0 0 0-9.05-3.67Zm0 23.06h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-4.03 1.06 1.07-3.93-.25-.4A10.6 10.6 0 0 1 5.35 16c0-5.88 4.79-10.66 10.67-10.66 2.85 0 5.53 1.11 7.54 3.13a10.6 10.6 0 0 1 3.12 7.54c0 5.88-4.78 10.65-10.66 10.65Zm5.85-7.98c-.32-.16-1.9-.94-2.19-1.04-.3-.11-.51-.16-.72.16-.21.32-.83 1.04-1.02 1.25-.19.21-.37.24-.69.08-.32-.16-1.36-.5-2.58-1.6-.96-.85-1.6-1.9-1.79-2.22-.19-.32-.02-.5.14-.66.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55l-.61-.01c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.65 0 1.57 1.14 3.08 1.3 3.29.16.21 2.24 3.42 5.43 4.8.76.33 1.35.52 1.81.67.76.24 1.45.21 2 .13.61-.09 1.9-.78 2.16-1.53.27-.75.27-1.39.19-1.53-.08-.13-.29-.21-.61-.37Z"
    ></path>
  </svg>
</a>

<style>
  .wa-float {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 95;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    color: #fff;
    background: #25d366;
    border: 1px solid rgba(201, 168, 76, 0.55);
    box-shadow:
      0 6px 20px rgba(0, 0, 0, 0.45),
      0 0 0 0 rgba(37, 211, 102, 0.45);
    text-decoration: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      background 0.3s ease;
  }
  .wa-float:hover,
  .wa-float:focus-visible {
    background: #1fb855;
    transform: translateY(-2px) scale(1.05);
    box-shadow:
      0 10px 26px rgba(0, 0, 0, 0.5),
      0 0 0 6px rgba(37, 211, 102, 0.18);
  }
  .wa-float__icon {
    width: 1.75rem;
    height: 1.75rem;
    display: block;
  }

  @media (max-width: 480px) {
    .wa-float {
      width: 3rem;
      height: 3rem;
    }
    .wa-float__icon {
      width: 1.6rem;
      height: 1.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float,
    .wa-float:hover,
    .wa-float:focus-visible {
      transform: none;
      transition: none;
    }
  }
</style>
