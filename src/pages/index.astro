---
import DarkLayout from "../layouts/DarkLayout.astro";
import { Image } from "astro:assets";
import WoodcutterF from "../assets/WoodcutterF.png";
import WoodcutterOnly from "../assets/WoodcutterOnly.png";
import ResonaraLondon from "../assets/ResonaraLondon.png";
import ResonaraBoxFinal from "../assets/ResonaraBoxFinal.png";
import HeroDesktop from "../assets/ResonaraLondonF.png";  
import HeroMobile  from "../assets/ResonaraLondonPortrait.png";   
---

<DarkLayout title="Resonara — Stillness of Mind<br /> In a Restless World" description="Ten minutes of Resonara. Eight hours of everything else.">
  <!-- ═══════════ HERO ═══════════ -->
<section class="hero">
 <picture class="hero-picture">
  <!-- Portrait — phones only (max 768px) -->
  <source
    srcset={HeroMobile.src}
    media="(max-width: 768px)"
  />
  <!-- Landscape — everything else -->
  <img
    src={HeroDesktop.src}
    alt="Stillness of mind in a restless world — Resonara"
    class="hero-img"
    loading="eager"
    fetchpriority="high"
  />
</picture>
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>

  <div class="hero-inner">

    <div class="hero-top">
  <h2 class="hero-eyebrow">
    Stillness of Mind<br />
    In a Restless World<br />
    <span class="hero-eyebrow-sub">Through Automated Himalayan Sound Therapy</span>
  </h2>
</div>

    <div class="hero-content">
      <h1 class="hero-title">Ten minutes of&nbsp;<span>Resonara</span></h1>
      <p class="hero-subtitle">Eight hours of everything else</p>
    </div>

    <div class="hero-bottom"></div>

  </div>

  <div class="scroll-cue">
    <span>Scroll to sharpen</span>
    <div class="scroll-line"></div>
  </div>
</section>

  <!-- ═══════════ WOODCUTTER SPLIT ═══════════ -->
  <section class="split-section">
    <div class="split-wrap">
        <div class="img-panel img-panel--woodcutter has-img reveal-left">
        <Image src={WoodcutterOnly} alt="Resonara singing bowl — ancient frequency, precision engineered" class="panel-img" width={900} quality={75} />
        <div class="img-overlay img-overlay--right"></div>
      </div>
      <div class="text-panel text-panel--right">
        <p class="label reveal">The Woodcutter's Secret</p>
        <h2 class="section-title reveal d1">Every morning, before the first swing,<br />he sharpens the axe.</h2>
        <p class="body-p reveal d2">Not because he doubts his strength. Not because the forest intimidates him. But because he understands something most people never learn —</p>
        <div class="pull-quote reveal d3"><p><em>his work begins before the work begins.</em></p></div>
        <div class="principle-trio reveal d4">
          <p><span>The stone sharpens the axe.</span><br />Resonara sharpens your mind.<br /><span>Ten minutes. Same principle. Different instrument.</span></p>
          <p class="principle-sub">Stone on blade. Resonara on your mind.</p>
        </div>
        <p class="body-p reveal d4">Then eight hours of clean, effortless cutting.</p>
      </div>
    </div>
  </section>

  <div class="ornament reveal"><span>✦</span></div>

  <!-- ═══════════ MIDDLE ═══════════ -->
  <section class="middle-section">
    <div class="middle-inner">
      <p class="bold-line reveal">We live in a world that worships the swing.</p>
      <p class="body-p reveal d1">
        More meetings. More decisions. More output. More hustle. We celebrate the person who starts earliest and stops latest. We have built an entire culture around the axe in motion.
      </p>
      <p class="nobody reveal d2">Nobody talks about the sharpening.</p>
      <p class="body-p reveal d3">
        And so we swing. Day after day. With a blunter blade than yesterday. Wondering why the same tree takes longer. Wondering why we are more tired with less to show for it.
      </p>
    </div>
  </section>

  <div class="ornament reveal"><span>✦</span></div>

  <!-- ═══════════ MEDITATOR SPLIT ═══════════ -->
  <section class="split-section">
    <div class="split-wrap">
      <div class="text-panel text-panel--left">
        <p class="bold-line reveal">Your brain is the axe.</p>
        <p class="body-p reveal d1">The tree is everything — your business, your relationships, your ambitions, the problems only you can solve.</p>
        <p class="body-p reveal d2">Ten minutes with Resonara is the sharpening. Calibrated frequency. Verified acoustic protocol. Ancient wisdom, now measurable.</p>
        <div class="pull-quote reveal d3">
          <p>
            Not meditation you have to figure out. Not silence you have to force. Just the right sound, at the right frequency, doing what it has always done —<br /><br /><em
              >returning you to centre before the world pulls you to the edges.</em
            >
          </p>
        </div>
      </div>
      <div class="img-panel img-panel--meditator has-img reveal-right">
        <Image src={WoodcutterF} alt="Elite athlete — Resonara sharpens focus before the match" class="panel-img" width={900} quality={75} loading="lazy" />
        <div class="img-overlay img-overlay--left"></div>
      </div>
    </div>
  </section>

  <!-- ═══════════ WORLD'S FIRST ═══════════ -->
  <div class="worlds-first reveal">
    <p class="wf-label">A New Category</p>
    <p class="wf-claim">The world's first <span>automated sound therapy system.</span></p>
    <p class="wf-sub">Used in professional cricket, football, corporate wellness, and luxury spas worldwide.</p>
    <p class="wf-dots">Verified by EEG &nbsp;·&nbsp; USPTO Patent Filed &nbsp;·&nbsp; Acoustically Certified</p>
  </div>

  <div style="width: 100vw; position: relative; left: 50%; transform: translateX(-50%);">
    <Image src={ResonaraBoxFinal} alt="ResonaraBoxFinal" width={1600} quality={80} loading="lazy" style="width: 100%; display: block;" />
  </div>

  <!-- ═══════════ PROOF BAND ═══════════ -->
  <div class="proof-band reveal">
    <p>Trusted by athletes, founders and executives across four continents</p>
    <p class="proof-cities">Singapore &nbsp;·&nbsp; Dubai &nbsp;·&nbsp; London &nbsp;·&nbsp; New York &nbsp;·&nbsp; San Francisco</p>
  </div>

  <!-- ═══════════ CLOSING ═══════════ -->
  <section class="closing">
    <div class="closing-inner">
      <p class="closing-main reveal">Sharpen first.<br />Then swing.</p>
      <p class="closing-sub reveal d1">Ten minutes of Resonara.<br />Eight hours of everything else.</p>
      <div class="divider-line reveal d2"></div>
      <a href="/who-its-for" class="cta-btn reveal d3"><span>Your ten minutes start here &nbsp;→</span></a>
    </div>
  </section>
</DarkLayout>

<style>
  /* ── HERO ── */
.hero {
  padding: clamp(5rem, 10vh, 7rem) 2rem 2rem;
  text-align: center;
  background: linear-gradient(to bottom, var(--dark) 0%, var(--dark-mid) 100%);
}
.hero .hero-content {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
  padding: 0 2rem;
}
.hero .cert-headline {
  font-family: "Cinzel", serif;
  font-size: clamp(1rem, 2.2vw, 1.5rem);
  font-weight: 600;
  color: var(--parchment);
  line-height: 2.2;
  letter-spacing: 0.05em;
  text-align: center;
  margin-bottom: 1.5rem;
}
.hero .rni-heading {
  font-family: "Cinzel", serif;
  font-size: clamp(1.3rem, 3vw, 2.2rem);
  font-weight: 600;
  color: var(--parchment);
  letter-spacing: 0.05em;
  text-align: center;
  white-space: nowrap;
}
.hero .rni-heading span {
  color: var(--gold);
}

/* ── VIDEO SECTION ── */
.video-section {
  width: 100%;
  max-width: 1200px;
  text-align: center;
  margin: 0 auto;
  padding: 4rem 2rem 1rem;
}
.strike-video {
  width: 100%;
  height: auto;
  border-radius: 8px;
  display: block;
}

/* ── MOBILE ONLY ── */
@media (max-width: 768px) {
  .hero .cert-headline {
    font-size: clamp(0.72rem, 3.4vw, 0.88rem);
    letter-spacing: 0.02em;
    line-height: 2.4;
    white-space: nowrap;
  }
  .hero .rni-heading {
    font-size: clamp(1rem, 5.5vw, 1.4rem);
    white-space: nowrap;
  }
}

/* ── SCIENCE SPLIT SECTIONS ── */
.science-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 80vh;
  align-items: stretch;
}
@media (max-width: 800px) {
  .science-section {
    grid-template-columns: 1fr;
    min-height: unset;
  }
  .science-section .img-side {
    order: 1;
  }
  .science-section .text-side {
    order: 2;
  }
  .science-section.reverse .img-side {
    order: 1;
  }
  .science-section.reverse .text-side {
    order: 2;
  }
}
.img-side {
  position: relative;
  overflow: hidden;
  min-height: 50vh;
  background: linear-gradient(135deg, rgba(201, 168, 76, 0.06), var(--dark-mid));
}
.img-side::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 200px;
  height: 200px;
  border-radius: 50%;
  border: 1px solid rgba(201, 168, 76, 0.15);
  box-shadow:
    0 0 0 50px rgba(201, 168, 76, 0.04),
    0 0 0 100px rgba(201, 168, 76, 0.025);
}
.panel-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  object-position: center;
  z-index: 0;
}
.has-img::after {
  display: none;
}
@media (max-width: 800px) {
  .img-side {
    min-height: 50vw;
    max-height: 380px;
  }
}
.img-overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}
.overlay-right {
  background: linear-gradient(to right, transparent, rgba(14, 12, 9, 0.5));
}
.overlay-left {
  background: linear-gradient(to left, transparent, rgba(14, 12, 9, 0.5));
}
@media (max-width: 800px) {
  .overlay-right,
  .overlay-left {
    background: linear-gradient(to bottom, transparent, rgba(14, 12, 9, 0.65));
  }
}
.text-side {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(2.5rem, 6vw, 5rem) clamp(1.8rem, 5vw, 4.5rem);
  background: var(--dark-mid);
}
.text-side.gold-tint {
  background: linear-gradient(135deg, rgba(201, 168, 76, 0.06), var(--dark-mid));
}

/* ── TYPOGRAPHIC HELPERS ── */
.section-num {
  font-family: "Cinzel", serif;
  font-size: clamp(2.5rem, 5vw, 4rem);
  color: rgba(201, 168, 76, 0.08);
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0.1em;
  margin-bottom: -0.5rem;
  display: block;
}
.stat-row {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin: 1.8rem 0;
}
.stat-pill {
  border: 1px solid rgba(201, 168, 76, 0.3);
  padding: 0.7rem 1.2rem;
  background: rgba(201, 168, 76, 0.05);
}
.stat-pill .stat-val {
  font-family: "Cinzel", serif;
  font-size: clamp(1.1rem, 2vw, 1.4rem);
  color: var(--gold);
  font-weight: 600;
  letter-spacing: 0.05em;
  display: block;
}
.stat-pill .stat-label {
  font-size: clamp(0.72rem, 1.2vw, 0.85rem);
  color: rgba(250, 245, 233, 0.55);
  letter-spacing: 0.12em;
  font-style: italic;
}

/* ── RNI SECTION ── */
.rni-section {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(201, 168, 76, 0.09), var(--dark-mid) 60%, var(--dark));
  border-top: 1px solid rgba(201, 168, 76, 0.18);
  border-bottom: 1px solid rgba(201, 168, 76, 0.18);
  padding: clamp(3.5rem, 8vw, 7rem) clamp(2rem, 6vw, 5rem);
}
.rni-content {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}
.rni-heading {
  font-family: "Cinzel", serif;
  font-size: clamp(1.3rem, 3vw, 2.2rem);
  font-weight: 600;
  color: var(--parchment);
  letter-spacing: 0.05em;
  line-height: 1.35;
  margin-bottom: 1.5rem;
}
.rni-heading span {
  color: var(--gold);
}
.rni-para {
  max-width: 680px;
  margin: 0 auto 1.5rem;
  text-align: center;
}
.freq-bands {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin: 1.8rem 0;
  text-align: left;
}
@media (max-width: 500px) {
  .freq-bands {
    grid-template-columns: 1fr;
  }
}
.freq-band {
  border: 1px solid rgba(201, 168, 76, 0.2);
  padding: 1rem 1.2rem;
  background: rgba(201, 168, 76, 0.04);
  transition: border-color 0.3s, background 0.3s;
}
.freq-band:hover {
  border-color: rgba(201, 168, 76, 0.5);
  background: rgba(201, 168, 76, 0.07);
}
.freq-name {
  font-family: "Cinzel", serif;
  font-size: clamp(0.75rem, 1.3vw, 0.88rem);
  color: var(--gold);
  letter-spacing: 0.18em;
  margin-bottom: 0.3rem;
}
.freq-hz {
  font-size: clamp(0.82rem, 1.4vw, 0.95rem);
  color: rgba(201, 168, 76, 0.55);
  font-style: italic;
  margin-bottom: 0.5rem;
}
.freq-desc {
  font-size: clamp(0.9rem, 1.5vw, 1.05rem);
  color: rgba(250, 245, 233, 0.7);
  line-height: 1.6;
}
.rni-validation {
  font-size: clamp(0.9rem, 1.5vw, 1.1rem);
  font-style: italic;
  color: rgba(201, 168, 76, 0.7);
  text-align: center;
  margin-top: 1rem;
}

/* ── CERT BAND ── */
.cert-band {
  background: var(--dark-mid);
  border-top: 1px solid rgba(201, 168, 76, 0.15);
  border-bottom: 1px solid rgba(201, 168, 76, 0.15);
  padding: clamp(3rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
  text-align: center;
}
.cert-label {
  font-family: "Cinzel", serif;
  font-size: clamp(0.75rem, 1.4vw, 0.88rem);
  letter-spacing: 0.38em;
  color: var(--gold);
  opacity: 0.8;
  margin-bottom: 0.8rem;
}
.cert-headline {
  font-family: "Cinzel", serif;
  font-size: clamp(1rem, 2.5vw, 1.4rem);
  font-weight: 600;
  color: var(--parchment);
  margin-top: 2rem;
  margin-bottom: 1rem;
  letter-spacing: 0.05em;
}
.cert-details {
  max-width: 700px;
  margin: 0 auto;
  border: 1px solid rgba(201, 168, 76, 0.2);
  background: rgba(201, 168, 76, 0.03);
}
.cert-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.85rem 1.4rem;
  border-bottom: 1px solid rgba(201, 168, 76, 0.1);
  gap: 1rem;
}
.cert-row:last-child {
  border-bottom: none;
}
.cert-key {
  font-family: "Cinzel", serif;
  font-size: clamp(0.68rem, 1.2vw, 0.8rem);
  letter-spacing: 0.2em;
  color: rgba(201, 168, 76, 0.6);
  white-space: nowrap;
  flex-shrink: 0;
}
.cert-val {
  font-size: clamp(0.9rem, 1.5vw, 1.05rem);
  color: var(--parchment);
  font-style: italic;
  text-align: right;
}
@media (max-width: 540px) {
  .cert-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }
  .cert-key {
    white-space: normal;
  }
  .cert-val {
    text-align: left;
  }
}

/* ── CLOSING ── */
.closing {
  text-align: center;
  padding: clamp(4rem, 10vw, 8rem) clamp(2rem, 5vw, 4rem);
  background: linear-gradient(to bottom, var(--dark-mid), var(--dark));
  position: relative;
  overflow: hidden;
}
.closing::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at center, rgba(201, 168, 76, 0.05) 0%, transparent 65%);
}
.closing-inner {
  position: relative;
  z-index: 1;
  max-width: 700px;
  margin: 0 auto;
}
.closing-main {
  font-family: "Cinzel", serif;
  font-size: clamp(1.5rem, 4.5vw, 3rem);
  font-weight: 400;
  color: var(--parchment);
  letter-spacing: 0.06em;
  line-height: 1.3;
  margin-bottom: 1.2rem;
}
.closing-main span {
  color: var(--gold);
}
.closing-sub {
  font-size: clamp(1.1rem, 2.2vw, 1.4rem);
  font-style: italic;
  color: rgba(250, 245, 233, 0.65);
  line-height: 1.8;
  margin-bottom: 2.5rem;
  max-width: 580px;
  margin-left: auto;
  margin-right: auto;
}
</style>
