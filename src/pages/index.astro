---
import { getImage, Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import BrainRhythms from "../components/BrainRhythms.astro";
import FeaturedStudy from "../components/FeaturedStudy.astro";
import Locations from "../components/Locations.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import { whatsappLink } from "../config/contact";
import { CONTACT_EMAIL, LEGAL_NAME, SITE_NAME, SITE_TAGLINE } from "../config/site";
import heroVideo from "../assets/site/hero.mp4";
import posterImage from "../assets/site/poster.jpg";
import productImage from "../assets/site/product.jpg";
import detailImage from "../assets/site/detail.jpg";
import frontImage from "../assets/site/front.jpg";
import peopleImage from "../assets/site/people.jpg";

const site = Astro.site ?? new URL("https://resonara.com");
const poster = await getImage({ src: posterImage, width: 1280, format: "webp" });
const logo = await getImage({ src: productImage, width: 1200, format: "jpg" });

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.href}#org`,
      name: SITE_NAME,
      legalName: LEGAL_NAME,
      url: site.href,
      logo: new URL(logo.src, site).href,
      email: CONTACT_EMAIL,
      slogan: SITE_TAGLINE,
    },
    { "@type": "WebSite", "@id": `${site.href}#site`, url: site.href, name: SITE_NAME, publisher: { "@id": `${site.href}#org` } },
  ],
};

const stripSizes = "(max-width: 700px) 100vw, 380px";
---

<SiteLayout
  title="Resonara | A live sound bath, on demand"
  description="Three hand-forged bronze singing bowls, played live on a solid teak instrument. A live sound bath, on demand, for yoga studios, workplaces and spas."
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-tagline">A live sound bath, on demand.</p>
          <div class="badges"><span class="badge accent">World's first</span><span class="badge">US Patented Technology</span></div>
          <h1>Stillness of mind in a restless world.</h1>
          <p class="lede">
            Real singing bowls, played live in the room, in sessions composed to melt stress, deepen meditation and ease the body toward rest. Installed, calibrated and maintained by us in your yoga
            studio, workplace or spa.
          </p>
          <div class="row">
            <a href="/waitlist/" class="btn btn-primary">Join the waitlist</a>
            <a href="#science" class="btn btn-ghost">See the science →</a>
          </div>
          <p class="sg-note only-sg" hidden>
            In Singapore? <a href={whatsappLink()} target="_blank" rel="noopener">Book a session at Resonara Sanctuary, Akshaya Yoga →</a>
          </p>
        </div>
        <div class="hero-media">
          <div class="video-slot">
            <video
              id="hero-video"
              muted
              loop
              playsinline
              preload="metadata"
              poster={poster.src}
              aria-label="Resonara intro film: real singing bowls played live in a studio, a spa and a workplace"
            >
              <source src={heroVideo} type="video/mp4" />
            </video>
            <button type="button" class="vs-btn vs-sound" id="hero-sound" aria-pressed="false">Sound on</button>
            <button type="button" class="vs-btn vs-pause" id="hero-pause" aria-pressed="false">Pause</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="chooser-band">
    <div class="wrap chooser-row">
      <p>I'm bringing Resonara to a…</p>
      <div class="row">
        <a href="/studios/" class="chip-btn">Yoga studio</a>
        <a href="/workplaces/" class="chip-btn">Workplace</a>
        <a href="/spas/" class="chip-btn">Spa or wellness resort</a>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What it is</span>
        <h2>Real singing bowls. Played live. Composed by us, chosen by you.</h2>
      </div>
      <div class="vis-strip">
        <figure>
          <Image src={detailImage} alt="A hand-forged bronze Resonara bowl resting on a padded cradle on the teak cabinet" widths={[400, 800, 1200]} sizes={stripSizes} />
          <figcaption>Hand-forged bronze</figcaption>
        </figure>
        <figure>
          <Image src={frontImage} alt="The Resonara instrument: three bronze bowls and their mallets on a teak cabinet" widths={[400, 800, 1200]} sizes={stripSizes} />
          <figcaption>Three bowls, one instrument</figcaption>
        </figure>
        <figure>
          <Image src={peopleImage} alt="Two people resting on yoga mats in front of the Resonara instrument" widths={[400, 800, 1200]} sizes={stripSizes} />
          <figcaption>Played live in the room</figcaption>
        </figure>
      </div>
      <div class="three">
        <div class="feature">
          <span class="idx">Bowls</span>
          <h3>Hand-forged, precisely calibrated.</h3>
          <p>Three bronze bowls selected to pair for alpha, theta and delta beats, with every mallet and strike speed tuned to draw them out.</p>
        </div>
        <div class="feature">
          <span class="idx">Mallets</span>
          <h3>A master's touch.</h3>
          <p>Every bowl has its own mallets, with their height, material and weight customized for that bowl. The speed of each strike is set by the composition.</p>
        </div>
        <div class="feature">
          <span class="idx">Programs</span>
          <h3>Programs composed by us.</h3>
          <p>Choose a program for focus, meditation or rest, then one of its preset lengths. The bowls play exactly as composed.</p>
        </div>
      </div>
      <p style="margin-top:28px"><a href="/how-it-works/" class="link-arrow">How it works →</a></p>
    </div>
  </section>

  <section class="band band-surface" id="spaces" style="border-block:1px solid var(--line);scroll-margin-top:70px">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Built for your space</span>
        <h2>Live sound. Built into your space.</h2>
      </div>
      <div class="seg-grid">
        <article class="seg-card">
          <span class="eyebrow" style="margin:0">Yoga studios</span>
          <h3>A class your members come back for, and no studio nearby can offer.</h3>
          <p class="promise">
            Add Nada Yoga, the yoga of sound, to your schedule, played live on real bowls. As an introductory offer, partner studios get local exclusivity from us for a limited time.
          </p>
          <ul class="fits">
            <li>Nada Yoga</li>
            <li>Shavasana</li>
            <li>Breathwork</li>
            <li>Yoga Nidra</li>
          </ul>
          <div class="row"><a href="/studios/" class="link-arrow">Explore for studios →</a><a href="/waitlist/?seg=studio" class="btn btn-ghost">Join the waitlist</a></div>
        </article>
        <article class="seg-card">
          <span class="eyebrow" style="margin:0">Workplaces</span>
          <h3>A reset for employees and teams that never stop.</h3>
          <p class="promise">Fifteen minutes of live sound. Back to work calm and focused.</p>
          <ul class="fits">
            <li>Sleeping pods</li>
            <li>Wellness rooms</li>
            <li>15-minute resets</li>
          </ul>
          <div class="row"><a href="/workplaces/" class="link-arrow">Explore for workplaces →</a><a href="/waitlist/?seg=workplace" class="btn btn-ghost">Join the waitlist</a></div>
        </article>
        <article class="seg-card">
          <span class="eyebrow" style="margin:0">Spas &amp; wellness resorts</span>
          <h3>A new modality for your spa menu.</h3>
          <p class="promise">Live sound on its own or alongside massage: your therapists calm the body, Resonara calms the mind.</p>
          <ul class="fits">
            <li>Treatment rooms</li>
            <li>Couples suites</li>
            <li>Relaxation lounges</li>
          </ul>
          <div class="row"><a href="/spas/" class="link-arrow">Explore for spas →</a><a href="/waitlist/?seg=spa" class="btn btn-ghost">Join the waitlist</a></div>
        </article>
      </div>
    </div>
  </section>

  <BrainRhythms id="science" canvas />

  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What the research shows</span>
        <h2>Calm you can measure.</h2>
      </div>
      <div class="tiles">
        <div class="tile"><span class="big">−21%</span><h3>Melt stress</h3><p>One singing-bowl session cut anxiety by 21% in a randomized controlled trial.†</p></div>
        <div class="tile">
          <span class="big">+37%</span><h3>Rest and recover</h3><p>Heart rate variability, your body's rest-and-recover signal, rose 37% within 30 minutes.†</p>
        </div>
        <div class="tile">
          <span class="big">2.5×</span><h3>Go deeper</h3><p>Slow theta and delta brain activity rose while people listened to a singing bowl, and activity at the bowl's beat rose 2.5 times.*</p>
        </div>
      </div>
      <div class="proof-line"><p>19 clinical studies. 8 countries. One ancient instrument.</p><a href="/research/" class="btn btn-ghost">See the research →</a></div>

      <FeaturedStudy />

      <div class="footnotes">
        <span>* Kim &amp; Choi, 2023, <i>International Journal of Environmental Research and Public Health</i>.</span>
        <span>† Rio-Alamos et al., 2023, <i>European Journal of Investigation in Health, Psychology and Education</i>.</span>
      </div>
    </div>
  </section>

  <section class="band band-surface" style="border-top:1px solid var(--line)">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Where we are</span>
        <h2>Live in Singapore. Coming soon to California.</h2>
        <p class="lede">We're partnering with a limited number of venues as we expand. Join the waitlist and we'll be in touch when Resonara reaches your city.</p>
      </div>
      <Locations />
      <WaitlistForm id="home" />
    </div>
  </section>
</SiteLayout>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---------- Hero film: autoplays muted; the two buttons toggle sound and playback ---------- */
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;
  const soundBtn = document.getElementById("hero-sound");
  const pauseBtn = document.getElementById("hero-pause");
  if (video && soundBtn && pauseBtn) {
    let pausedByTab = false;
    const showPaused = (paused: boolean) => {
      pauseBtn.textContent = paused ? "Play" : "Pause";
      pauseBtn.setAttribute("aria-pressed", String(paused));
    };
    const play = () => video.play().catch(() => showPaused(true));

    if (reduceMotion) showPaused(true);
    else play();

    video.addEventListener("pause", () => showPaused(true));
    video.addEventListener("play", () => showPaused(false));
    pauseBtn.addEventListener("click", () => (video.paused ? play() : video.pause()));
    soundBtn.addEventListener("click", () => {
      video.muted = !video.muted;
      soundBtn.textContent = video.muted ? "Sound on" : "Sound off";
      soundBtn.setAttribute("aria-pressed", String(!video.muted));
      if (!video.muted && video.paused) play();
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && !video.paused) {
        video.pause();
        pausedByTab = true;
      } else if (!document.hidden && pausedByTab) {
        pausedByTab = false;
        play();
      }
    });
  }

  /* ---------- Beat line: two close tones drifting in and out of phase, drawn in the theme's copper ---------- */
  const canvas = document.getElementById("beat-canvas") as HTMLCanvasElement | null;
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const k1 = (2 * Math.PI) / 30;
    const k2 = (2 * Math.PI) / 32.2;
    let width = 0;
    let height = 0;
    let phase = 0;
    let frame = 0;

    const resize = () => {
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const draw = () => {
      const mid = height / 2;
      const amp = height * 0.3;
      ctx.clearRect(0, 0, width, height);
      ctx.strokeStyle = getComputedStyle(canvas).getPropertyValue("--copper").trim() || "#9C6346";
      ctx.lineWidth = 1.2;
      ctx.globalAlpha = 0.7;
      ctx.beginPath();
      for (let x = 0; x <= width; x += 1.5) {
        const y = mid - (amp * (Math.sin(k1 * x - phase) + Math.sin(k2 * x - phase * 0.93))) / 2;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
      ctx.globalAlpha = 0.28;
      ctx.setLineDash([3, 5]);
      for (const sign of [1, -1]) {
        ctx.beginPath();
        for (let x = 0; x <= width; x += 3) {
          const y = mid - sign * amp * Math.abs(Math.cos(((k1 - k2) * x - phase * 0.07) / 2));
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.globalAlpha = 1;
    };
    const loop = () => {
      phase += 0.035;
      draw();
      frame = requestAnimationFrame(loop);
    };

    resize();
    draw();
    window.addEventListener("resize", () => {
      resize();
      draw();
    });
    if (reduceMotion) {
      // Static line: redraw only when the theme changes so the colour stays right.
      new MutationObserver(draw).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", draw);
    } else {
      frame = requestAnimationFrame(loop);
      document.addEventListener("visibilitychange", () => {
        cancelAnimationFrame(frame);
        if (!document.hidden) frame = requestAnimationFrame(loop);
      });
    }
  }
</script>
