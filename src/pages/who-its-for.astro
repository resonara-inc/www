---
import DarkLayout from "../layouts/DarkLayout.astro";
import { Image } from "astro:assets";
import CorporateNY2 from "../assets/CorporateNY2.png";
import ResonaraDubai2 from "../assets/ResonaraDubai2.png";
import ResonaraFootball1 from "../assets/ResonaraFootball1.png";
import SFOStartup1 from "../assets/SFOStartup1.png";
import ResonaraCricket1 from "../assets/ResonaraCricket1.png";
import ResonaraLondon from "../assets/ResonaraLondon.png";
import Resonaracorporate6 from "../assets/Resonaracorporate6.png";
import CorporateGirl88 from "../assets/CorporateGirl88.png";
import LCR from "../assets/LCR.png";
---

<DarkLayout title="Resonara — Who It's For" description="The founder. The executive. The performer. The elite athlete. Built for people who cannot afford to be dull.">
  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow reveal">The People Resonara Is Built For</p>
      <h1 class="hero-title reveal d1">
        You already know.<br /><span>You cannot stop.</span>
      </h1>
      <p class="hero-pause reveal d2">But can you pause — ten minutes, daily?</p>
      <p class="hero-sub reveal d3">
        The founder. The executive. The performer. The elite athlete. They live at different edges — but they share one problem. The swing never stops. The sharpening never starts.
      </p>
      <nav class="persona-nav reveal d4">
        <a href="#optimiser">The Optimiser</a>
        <a href="#executive">The Executive</a>
        <a href="#performer">The Performer</a>
        <a href="#founder">The Founder</a>
        <a href="#athlete">The Athlete</a>
        <a href="#leader">The Leader</a>
      </nav>
    </div>
  </section>

  <!-- ═══════════ 1. THE FOUNDER ═══════════ -->
  <section class="persona-card right" id="founder">
    <div class="persona-text">
      <p class="persona-tag reveal d1">The Founder</p>
      <h2 class="persona-headline reveal d2">You carry the company<br /><span>in your nervous system.</span></h2>
      <p class="persona-body reveal d3">
        Every unresolved problem, every investor conversation, every difficult hire — your body is storing it all. Founders are trained to move forward. Nobody trained them to recover. Resonara is the
        protocol that separates the version of you that built last quarter from the version that will build next year. Ten minutes. Then back into it.
      </p>
      <div class="persona-quote reveal d4"><p>The company is only as sharp as the person running it. Sharpen first.</p></div>
      <div class="persona-stats reveal d4">
        <div class="stat-pill"><span class="stat-val">Daily</span><span class="stat-label">Recovery</span></div>
        <div class="stat-pill"><span class="stat-val">10 min</span><span class="stat-label">Protocol</span></div>
        <div class="stat-pill"><span class="stat-val">EEG</span><span class="stat-label">Proven</span></div>
      </div>
    </div>
    <div class="persona-img persona-img--founder has-img reveal-right">
      <Image src={Resonaracorporate6} alt="San Francisco — Resonara for the Founder" class="panel-img" width={900} quality={75} loading="lazy" />
      <div class="persona-img-overlay persona-img-overlay--left"></div>
    </div>
  </section>

  <div class="connector"></div>

  <!-- ═══════════ 2. THE OPTIMISER ═══════════ -->
  <section class="persona-card left" id="optimiser">
    <div class="persona-img persona-img--optimiser has-img reveal-left">
      <Image src={CorporateGirl88} alt="New York — Resonara for the Optimiser" class="panel-img" width={900} quality={75} loading="lazy" />
      <div class="persona-img-overlay"></div>
    </div>
    <div class="persona-text">
      <p class="persona-tag reveal d1">The Optimiser</p>
      <h2 class="persona-headline reveal d2">She did not step out of the office.<br /><span>She brought the calm to it.</span></h2>
      <p class="persona-body reveal d3">
        For the woman who runs the world — the meetings, the decisions, the home, the presence required of her at every moment. The world doesn't pause. Neither does she. Resonara fits into your life,
        not the other way around. Ten minutes. The nervous system finally gets what it's owed.
      </p>
      <div class="persona-quote reveal d4"><p>The recovery stack your body has been waiting for. Ancient wisdom perfected it, Resonara science built it.</p></div>
      <div class="persona-stats reveal d4">
        <div class="stat-pill"><span class="stat-val">EEG</span><span class="stat-label">Biometric</span></div>
        <div class="stat-pill"><span class="stat-val">HRV</span><span class="stat-label">Validated</span></div>
        <div class="stat-pill"><span class="stat-val">Stack</span><span class="stat-label">Complete</span></div>
      </div>
    </div>
  </section>

  <div class="connector"></div>

  <!-- ═══════════ 3. THE WINNING TEAM ═══════════ -->
  <section class="persona-card right" id="leader">
    <div class="persona-text">
      <p class="persona-tag reveal d1">The Winning Team</p>
      <h2 class="persona-headline reveal d2">The team that resonates together.<br /><span>Builds together.</span></h2>
      <p class="persona-body reveal d3">
        Your team doesn't have a performance problem. It has a recovery deficit. The meetings, the travel, the responsibilities. The team sits together in a Resonara session. No agenda. No slides.
        Just the bowls, the breath, and the reset. The most powerful meetings begin before a word is spoken.
      </p>
      <div class="persona-quote reveal d4"><p>Stillness is not a reward. It is a requirement. Ten minutes. Then build together, again</p></div>
      <div class="persona-stats reveal d4">
        <div class="stat-pill"><span class="stat-val">Alpha</span><span class="stat-label">State Protocol</span></div>
        <div class="stat-pill"><span class="stat-val">10 min</span><span class="stat-label">Daily</span></div>
        <div class="stat-pill"><span class="stat-val">Patent</span><span class="stat-label">Filed</span></div>
      </div>
    </div>
    <div class="persona-img persona-img--leader has-img reveal-right">
      <Image src={LCR} alt="London — Resonara for the Leader" class="panel-img" width={900} quality={75} loading="lazy" />
      <div class="persona-img-overlay persona-img-overlay--left"></div>
    </div>
  </section>

  <div class="connector"></div>

  <!-- ═══════════ 4. THE PERFORMER ═══════════ -->
  <section class="persona-card left" id="performer">
    <div class="persona-img persona-img--performer has-img reveal-left">
      <Image src={ResonaraFootball1} alt="Professional football — Resonara for the Performer" class="panel-img" width={900} quality={75} loading="lazy" />
      <div class="persona-img-overlay"></div>
    </div>
    <div class="persona-text">
      <p class="persona-tag reveal d1">The Performer</p>
      <h2 class="persona-headline reveal d2">Between the roar and the return.</h2>
      <p class="persona-body reveal d3">
        The match demands everything. The crowd, the pressure, the precision — your nervous system absorbs it all. Recovery isn't rest. It's a protocol. Resonara resets the nervous system between the
        performance and the next one. Measurably. Scientifically. Without a pill.
      </p>
      <div class="persona-quote reveal d4">
        <p>Before the performance, there is the preparation. <br /><span> Ten minutes. Then perform.</span></p>
        <div class="persona-stats reveal d4">
          <div class="stat-pill"><span class="stat-val">EEG</span><span class="stat-label">Biometric</span></div>
          <div class="stat-pill"><span class="stat-val">HRV</span><span class="stat-label">Validated</span></div>
          <div class="stat-pill"><span class="stat-val">Pre-Game</span><span class="stat-label">Protocol</span></div>
        </div>
      </div>
    </div>

    <div class="connector"></div>

    <!-- ═══════════ 5. THE BUSINESSMAN ═══════════ -->
    <section class="persona-card right" id="businessman">
      <div class="persona-text">
        <p class="persona-tag reveal d1">The Businessman</p>
        <h2 class="persona-headline reveal d2">Your decisions are worth millions.<br /><span>Your clarity is worth more.</span></h2>
        <p class="persona-body reveal d3">
          You see clearly when others cannot. But decision fatigue is not a motivational problem — it is a neurological one. A nervous system running on cortisol and unprocessed stress produces
          different quality decisions than one that has been reset. Resonara is ten minutes of calibrated frequency. The boardroom gets the best version of you.
        </p>
        <div class="persona-quote reveal d4"><p>Not relaxation. Recalibration. There is a difference — and your P&L knows it.</p></div>
        <div class="persona-stats reveal d4">
          <div class="stat-pill"><span class="stat-val">10 min</span><span class="stat-label">Protocol</span></div>
          <div class="stat-pill"><span class="stat-val">Daily</span><span class="stat-label">Reset</span></div>
          <div class="stat-pill"><span class="stat-val">EEG</span><span class="stat-label">Proven</span></div>
        </div>
      </div>
      <div class="persona-img persona-img--executive has-img reveal-right">
        <Image src={ResonaraDubai2} alt="Dubai — Resonara for the Businessman" class="panel-img" width={900} quality={75} loading="lazy" />
        <div class="persona-img-overlay persona-img-overlay--left"></div>
      </div>
    </section>

    <div class="connector"></div>

    <!-- ═══════════ 6. THE ATHLETE ═══════════ -->
    <section class="persona-card left" id="athlete">
      <div class="persona-img persona-img--athlete has-img reveal-left">
        <Image src={ResonaraCricket1} alt="Professional cricket — Resonara for the Athlete" class="panel-img" width={900} quality={75} loading="lazy" />
        <div class="persona-img-overlay"></div>
      </div>
      <div class="persona-text">
        <p class="persona-tag reveal d1">The Athlete</p>
        <h2 class="persona-headline reveal d2">100,000 people. One game.<br /><span>Everything on the line.</span></h2>
        <p class="persona-body reveal d3">
          For the performer who lives at the edge — the body keeps the score. Every game, every press, every camera, every moment where everything depends on you. Resonara is the reset button science
          built and ancient wisdom perfected.
        </p>
        <div class="persona-quote reveal d4">
          <p>From international cricket circuits to Premier League training rooms — elite sport has always had a recovery edge. The reset button science built and ancient wisdom perfected.</p>
        </div>
        <div class="persona-stats reveal d4">
          <div class="stat-pill"><span class="stat-val">HRV</span><span class="stat-label">Recovery</span></div>
          <div class="stat-pill"><span class="stat-val">Delta</span><span class="stat-label">Sleep Protocol</span></div>
          <div class="stat-pill"><span class="stat-val">EEG</span><span class="stat-label">Validated</span></div>
        </div>
      </div>
    </section>

    <!-- ═══════════ CLOSING ═══════════ -->
    <section class="closing">
      <div class="closing-inner">
        <div class="section-label reveal">For Every Edge</div>
        <p class="closing-main reveal d1">The swing never stops.<br /><span>At least sharpen first.</span></p>
        <p class="closing-sub reveal d2">Ten minutes of Resonara. Every morning. Before the world asks for everything you have — make sure you have it to give.</p>
        <a href="/science" class="cta-btn reveal d3"><span>Read the Science &nbsp;→</span></a>
      </div>
    </section>
  </section>

  <style>
    /* ── HERO ── */
    .hero {
      min-height: 72vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: clamp(5rem, 12vw, 9rem) clamp(1.5rem, 5vw, 2rem) 4rem;
      background: linear-gradient(to bottom, var(--dark), var(--dark-mid));
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, rgba(201, 168, 76, 0.06) 0%, transparent 70%);
    }
    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 820px;
    }
    .hero-eyebrow {
      font-family: "Cinzel", serif;
      font-size: clamp(0.7rem, 1.8vw, 0.9rem);
      letter-spacing: 0.42em;
      color: var(--gold);
      margin-bottom: 1.5rem;
      opacity: 0.85;
    }
    .hero-title {
      font-family: "Cinzel", serif;
      font-size: clamp(2rem, 6vw, 4.4rem);
      font-weight: 400;
      line-height: 1.2;
      color: var(--parchment);
      letter-spacing: 0.05em;
      margin-bottom: 1.5rem;
    }
    .hero-title span {
      color: var(--gold);
    }
    .hero-sub {
      font-size: clamp(1.1rem, 2.2vw, 1.45rem);
      font-style: italic;
      color: rgba(250, 245, 233, 0.7);
      line-height: 1.8;
      max-width: 640px;
      margin: 0 auto 2.5rem;
    }
    .hero-pause {
      font-family: "Cinzel", serif;
      font-size: clamp(1.1rem, 2.2vw, 1.6rem);
      font-weight: 400;
      color: var(--gold);
      letter-spacing: 0.08em;
      font-style: italic;
      margin-bottom: 2rem;
      opacity: 0.92;
    }
    /* ── PERSONA NAV (in-page) ── */
    .persona-nav {
      display: flex;
      gap: clamp(0.8rem, 2vw, 1.8rem);
      flex-wrap: wrap;
      justify-content: center;
      margin-top: 0;
    }
    .persona-nav a {
      font-family: "Cinzel", serif;
      font-size: clamp(0.7rem, 1.2vw, 0.78rem);
      letter-spacing: 0.22em;
      color: rgba(201, 168, 76, 0.55);
      text-decoration: none;
      transition: color 0.3s;
      padding: 0.25rem 0;
    }
    .persona-nav a:hover {
      color: var(--gold);
    }

    /* ── PERSONA CARDS ── */
    .persona-card {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 80vh;
      align-items: stretch;
      scroll-margin-top: 5rem;
    }
    .persona-card.left {
      background: var(--dark-mid);
    }
    .persona-card.right {
      background: var(--dark);
    }
    @media (max-width: 800px) {
      .persona-card {
        grid-template-columns: 1fr;
        min-height: unset;
      }
      .persona-card .persona-img {
        order: 1;
      }
      .persona-card .persona-text {
        order: 2;
      }
      .persona-card.right .persona-img {
        order: 1;
      }
      .persona-card.right .persona-text {
        order: 2;
      }
    }

    .persona-img {
      position: relative;
      overflow: hidden;
      min-height: 50vh;
      background: linear-gradient(135deg, rgba(201, 168, 76, 0.07), var(--dark));
    }
    .persona-img::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 180px;
      height: 180px;
      border-radius: 50%;
      border: 1px solid rgba(201, 168, 76, 0.14);
      box-shadow:
        0 0 0 45px rgba(201, 168, 76, 0.04),
        0 0 0 90px rgba(201, 168, 76, 0.02);
    }
    @media (max-width: 800px) {
      .persona-img {
        min-height: 50vw;
        max-height: 360px;
      }
    }
    .persona-img-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, transparent, rgba(14, 12, 9, 0.5));
    }
    .persona-img-overlay--left {
      background: linear-gradient(to left, transparent, rgba(14, 12, 9, 0.5));
    }
    @media (max-width: 800px) {
      .persona-img-overlay,
      .persona-img-overlay--left {
        background: linear-gradient(to bottom, transparent, rgba(14, 12, 9, 0.65));
      }
    }

    .persona-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 4.5rem);
    }
    .persona-card.left .persona-text {
      background: linear-gradient(225deg, rgba(201, 168, 76, 0.05), var(--dark-mid));
    }
    .persona-card.right .persona-text {
      background: linear-gradient(135deg, rgba(201, 168, 76, 0.05), var(--dark));
    }

    .persona-tag {
      font-family: "Cinzel", serif;
      font-size: clamp(0.8rem, 1.4vw, 0.95rem);
      letter-spacing: 0.38em;
      color: var(--gold);
      opacity: 0.9;
      margin-bottom: 1.6rem;
    }
    .persona-headline {
      font-family: "Cinzel", serif;
      font-size: clamp(1.1rem, 2.5vw, 1.8rem);
      font-weight: 600;
      color: var(--parchment);
      letter-spacing: 0.05em;
      line-height: 1.3;
      margin-bottom: 2rem;
    }
    .persona-headline span {
      color: var(--gold);
    }
    .persona-body {
      font-size: clamp(1rem, 1.8vw, 1.25rem);
      line-height: 1.9;
      color: rgba(250, 245, 233, 0.8);
      margin-bottom: 1rem;
    }
    .persona-quote {
      border-left: 2px solid var(--gold);
      padding: 1rem 1.5rem;
      margin: 1.4rem 0;
      background: rgba(201, 168, 76, 0.04);
    }
    .persona-quote p {
      font-size: clamp(1rem, 1.7vw, 1.2rem);
      font-style: italic;
      color: var(--gold-pale);
      line-height: 1.75;
    }
    .persona-stats {
      display: flex;
      gap: 0.7rem;
      flex-wrap: wrap;
      margin-top: 0.5rem;
    }
    .stat-pill {
      border: 1px solid rgba(201, 168, 76, 0.3);
      padding: 0.5rem 0.9rem;
      background: rgba(201, 168, 76, 0.04);
    }
    .stat-pill .stat-val {
      font-family: "Cinzel", serif;
      font-size: clamp(0.78rem, 1.2vw, 0.92rem);
      color: var(--gold);
      font-weight: 600;
      letter-spacing: 0.08em;
      display: block;
    }
    .stat-pill .stat-label {
      font-size: clamp(0.65rem, 1vw, 0.75rem);
      color: rgba(250, 245, 233, 0.48);
      letter-spacing: 0.12em;
      font-style: italic;
    }

    .panel-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
      z-index: 0;
    }
    .persona-img-overlay,
    .persona-img-overlay--left {
      z-index: 1;
    }
    .has-img::after {
      display: none;
    }

    /* ── CONNECTOR ── */
    .connector {
      width: 1px;
      height: 60px;
      margin: 0 auto;
      background: linear-gradient(to bottom, transparent, rgba(201, 168, 76, 0.28), transparent);
    }

    /* ── CLOSING ── */
    .closing {
      text-align: center;
      padding: clamp(5rem, 11vw, 9rem) clamp(2rem, 5vw, 4rem);
      background: linear-gradient(to bottom, var(--dark-mid), var(--dark));
      position: relative;
      overflow: hidden;
    }
    .closing::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, rgba(201, 168, 76, 0.05) 0%, transparent 65%);
    }
    .closing-inner {
      position: relative;
      z-index: 1;
      max-width: 680px;
      margin: 0 auto;
    }
    .closing-main {
      font-family: "Cinzel", serif;
      font-size: clamp(1.5rem, 5vw, 3.2rem);
      font-weight: 400;
      color: var(--parchment);
      letter-spacing: 0.07em;
      line-height: 1.3;
      margin-bottom: 1.2rem;
    }
    .closing-main span {
      color: var(--gold);
    }
    .closing-sub {
      font-size: clamp(1.1rem, 2.5vw, 1.5rem);
      font-style: italic;
      color: var(--gold-pale);
      opacity: 0.82;
      margin-bottom: 3rem;
      line-height: 1.7;
    }
  </style>
</DarkLayout>
