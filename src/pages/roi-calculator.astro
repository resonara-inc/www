---
import DarkLayout from "../layouts/DarkLayout.astro";
---

<DarkLayout title="Resonara — Franchisee ROI Calculator" description="Model your earnings per machine, per month.">
  <div class="roi-calculator">
    <!-- ═══════════ HERO ═══════════ -->
    <section class="px-8 pt-16 pb-12 md:px-16 lg:px-24 xl:pt-24 xl:pb-16">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="text-balance text-5xl font-semibold leading-tight tracking-tight text-foreground md:text-6xl lg:text-7xl">
          Franchisee <span class="text-[var(--accent)]">ROI</span> Calculator
        </h1>
        <p class="mt-4 text-lg tracking-wide text-muted-foreground md:text-xl">Model your earnings · Per machine · Per month</p>
      </div>
    </section>

    <!-- ═══════════ INVESTMENT SUMMARY ═══════════ -->
    <section class="px-8 pb-12 md:px-16 lg:px-24">
      <div class="mx-auto max-w-4xl">
        <div class="grid gap-6 rounded-lg border border-border bg-card p-8 md:grid-cols-3 md:gap-8">
          <div class="text-center">
            <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground">Total Investment</p>
            <p class="mt-2 text-3xl font-semibold tracking-tight text-foreground">$6,000</p>
            <p class="mt-1 text-xs text-muted-foreground tracking-wide">per machine</p>
          </div>
          <div class="text-center">
            <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground">Franchise Fee</p>
            <p class="mt-2 text-3xl font-semibold tracking-tight text-foreground">$2,000</p>
            <p class="mt-1 text-xs text-muted-foreground tracking-wide">non-refundable</p>
          </div>
          <div class="text-center">
            <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground">Revenue Credit</p>
            <p class="mt-2 text-3xl font-semibold tracking-tight text-foreground">$4,000</p>
            <p class="mt-1 text-xs text-muted-foreground tracking-wide">offset vs. 20% revenue share</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ DIVIDER ═══════════ -->
    <div class="mx-auto max-w-4xl px-8 md:px-16 lg:px-24">
      <hr class="border-border" />
    </div>

    <!-- ═══════════ CALCULATOR ═══════════ -->
    <section class="px-8 py-16 md:px-16 lg:px-24 xl:py-20">
      <div class="mx-auto max-w-4xl">
        <div class="grid items-start gap-8 lg:grid-cols-2">
          <!-- INPUT PANEL -->
          <div class="rounded-lg border border-border bg-card p-8">
            <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground mb-8">Your Session Parameters</p>

            <!-- Price Per Session -->
            <div class="mb-7">
              <label for="pricePerSession" class="block text-xs font-medium tracking-widest uppercase text-muted-foreground mb-2"> Price Per Session </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-medium text-muted-foreground pointer-events-none">$</span>
                <input
                  type="number"
                  id="pricePerSession"
                  value="80"
                  min="1"
                  max="500"
                  step="5"
                  class="w-full rounded-md border border-border bg-[var(--background)] py-3 pl-8 pr-4 text-lg font-medium text-foreground outline-none transition focus:border-[var(--accent)] focus:ring-1 focus:ring-[var(--accent)] [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                />
              </div>
              <input type="range" id="ppsSlider" min="20" max="300" value="80" class="roi-slider mt-2 w-full" />
            </div>

            <!-- Sessions Per Day -->
            <div class="mb-7">
              <label for="sessionsPerDay" class="block text-xs font-medium tracking-widest uppercase text-muted-foreground mb-2"> Sessions Per Day </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-medium text-muted-foreground pointer-events-none">#</span>
                <input
                  type="number"
                  id="sessionsPerDay"
                  value="8"
                  min="1"
                  max="30"
                  step="1"
                  class="w-full rounded-md border border-border bg-[var(--background)] py-3 pl-8 pr-20 text-lg font-medium text-foreground outline-none transition focus:border-[var(--accent)] focus:ring-1 focus:ring-[var(--accent)] [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs tracking-widest uppercase text-muted-foreground pointer-events-none">sessions</span>
              </div>
              <input type="range" id="spdSlider" min="1" max="24" value="8" class="roi-slider mt-2 w-full" />
            </div>

            <!-- Operating Days Per Month -->
            <div class="mb-7">
              <label for="daysPerMonth" class="block text-xs font-medium tracking-widest uppercase text-muted-foreground mb-2"> Operating Days Per Month </label>
              <div class="relative">
                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-sm font-medium text-muted-foreground pointer-events-none">#</span>
                <input
                  type="number"
                  id="daysPerMonth"
                  value="25"
                  min="1"
                  max="31"
                  step="1"
                  class="w-full rounded-md border border-border bg-[var(--background)] py-3 pl-8 pr-16 text-lg font-medium text-foreground outline-none transition focus:border-[var(--accent)] focus:ring-1 focus:ring-[var(--accent)] [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
                />
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-xs tracking-widest uppercase text-muted-foreground pointer-events-none">days</span>
              </div>
              <input type="range" id="dpmSlider" min="10" max="31" value="25" class="roi-slider mt-2 w-full" />
              <p class="mt-1 text-xs text-muted-foreground pl-0.5">Typical spa/clinic: 25 days</p>
            </div>

            <!-- Number of Machines -->
            <div>
              <label class="block text-xs font-medium tracking-widest uppercase text-muted-foreground mb-2"> Number of Machines </label>
              <div class="grid grid-cols-4 gap-2">
                <button
                  class="machine-btn active rounded-md border border-border bg-[var(--background)] py-2.5 text-sm font-medium text-muted-foreground transition hover:border-[var(--accent)] hover:text-foreground"
                  data-val="1">1</button
                >
                <button
                  class="machine-btn rounded-md border border-border bg-[var(--background)] py-2.5 text-sm font-medium text-muted-foreground transition hover:border-[var(--accent)] hover:text-foreground"
                  data-val="2">2</button
                >
                <button
                  class="machine-btn rounded-md border border-border bg-[var(--background)] py-2.5 text-sm font-medium text-muted-foreground transition hover:border-[var(--accent)] hover:text-foreground"
                  data-val="3">3</button
                >
                <button
                  class="machine-btn rounded-md border border-border bg-[var(--background)] py-2.5 text-sm font-medium text-muted-foreground transition hover:border-[var(--accent)] hover:text-foreground"
                  data-val="5">5</button
                >
              </div>
              <input type="hidden" id="numMachines" value="1" />
            </div>
          </div>

          <!-- OUTPUT PANEL -->
          <div class="rounded-lg border border-border bg-card p-8">
            <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground mb-6">Your Earnings Projection</p>

            <!-- Hero metric -->
            <div class="text-center py-6 mb-4">
              <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground mb-3">Monthly Net — Per Machine</p>
              <p class="text-5xl font-semibold tracking-tight text-foreground transition-all md:text-6xl" id="netMonthlyPerMachine">$0</p>
              <p class="mt-2 text-xs tracking-widest uppercase text-muted-foreground">after 20% Resonara share</p>
            </div>

            <!-- Metric rows -->
            <div class="divide-y divide-border">
              <div class="flex items-baseline justify-between py-4">
                <div>
                  <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground">Gross Monthly Revenue</p>
                  <p class="mt-0.5 text-xs text-muted-foreground" id="revenueFormula">— sessions × days × price</p>
                </div>
                <p class="text-2xl font-semibold tracking-tight text-foreground" id="grossMonthly">$0</p>
              </div>

              <div class="flex items-baseline justify-between py-4">
                <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground">Resonara Share (20%)</p>
                <p class="text-2xl font-semibold tracking-tight text-muted-foreground" id="resonaraShare">$0</p>
              </div>

              <div class="flex items-baseline justify-between py-4">
                <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground">Net Monthly — Per Machine</p>
                <p class="text-2xl font-semibold tracking-tight text-foreground" id="netMonthly2">$0</p>
              </div>

              <div class="flex items-baseline justify-between py-4">
                <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground">Net Annual — Per Machine</p>
                <p class="text-2xl font-semibold tracking-tight text-foreground" id="netAnnual">$0</p>
              </div>

              <div class="flex items-baseline justify-between py-4">
                <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground">Total Net — All Machines / Year</p>
                <p class="text-2xl font-semibold tracking-tight text-foreground" id="totalAnnual">$0</p>
              </div>
            </div>

            <!-- Payback meter -->
            <div class="mt-6 rounded-md bg-[var(--background)] border border-border p-6">
              <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground mb-4">Investment Payback Period</p>
              <div class="h-1 w-full rounded-full bg-muted overflow-hidden mb-3">
                <div class="h-full rounded-full bg-[var(--accent)] transition-all duration-500 ease-out" id="paybackBar" style="width:0%"></div>
              </div>
              <div>
                <span class="text-2xl font-semibold tracking-tight text-foreground" id="paybackMonths">—</span>
                <span class="ml-2 text-xs text-muted-foreground">months to recover $4,000 credit</span>
              </div>
              <p class="mt-1 text-xs text-muted-foreground" id="paybackNote"></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════ SCALE TABLE ═══════════ -->
    <section class="px-8 pb-16 md:px-16 lg:px-24 xl:pb-20" id="multiTableSection">
      <div class="mx-auto max-w-4xl">
        <div class="mx-auto max-w-4xl px-0">
          <hr class="border-border mb-12" />
        </div>
        <p class="text-xs font-medium tracking-widest uppercase text-muted-foreground text-center mb-8">Scale Projection — All Machines Combined</p>
        <div class="overflow-x-auto rounded-lg border border-border bg-card">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="px-6 py-3 text-left text-xs font-medium tracking-widest uppercase text-muted-foreground">Horizon</th>
                <th class="px-6 py-3 text-right text-xs font-medium tracking-widest uppercase text-muted-foreground">Gross Revenue</th>
                <th class="px-6 py-3 text-right text-xs font-medium tracking-widest uppercase text-muted-foreground">Resonara Share</th>
                <th class="px-6 py-3 text-right text-xs font-medium tracking-widest uppercase text-muted-foreground">Your Net</th>
              </tr>
            </thead>
            <tbody id="tableBody" class="divide-y divide-border"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ═══════════ DISCLAIMER ═══════════ -->
    <section class="px-8 pb-16 md:px-16 lg:px-24">
      <div class="mx-auto max-w-4xl text-center">
        <hr class="border-border mb-8" />
        <p class="text-xs leading-relaxed text-muted-foreground tracking-wide">
          Projections are illustrative and based on inputs provided.<br />
          Actual earnings depend on utilisation, location, and operating efficiency.<br />
          <span class="text-foreground font-medium">$4,000 revenue credit</span> is applied against cumulative 20% revenue share until fully absorbed.
        </p>
      </div>
    </section>
  </div>
</DarkLayout>

<style is:global>
  .roi-calculator {
    padding-top: 5rem;
    font-family: "Inter", "system-ui", sans-serif;
  }

  /* Slider styling */
  .roi-slider {
    -webkit-appearance: none;
    appearance: none;
    height: 2px;
    border-radius: 1px;
    background: var(--muted);
    outline: none;
    cursor: pointer;
  }

  .roi-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--background);
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.1);
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  .roi-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }

  .roi-slider::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--background);
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.1);
    cursor: pointer;
  }

  /* Active machine button */
  .machine-btn.active {
    background-color: var(--foreground);
    border-color: var(--foreground);
    color: var(--background);
  }

  /* Tighten table cells on mobile */
  @media (max-width: 540px) {
    .roi-calculator table th,
    .roi-calculator table td {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }
</style>

<script>
  const fmt = (n: number) => "$" + Math.round(n).toLocaleString("en-US");

  function getInputs() {
    return {
      price: parseFloat((document.getElementById("pricePerSession") as HTMLInputElement).value) || 0,
      sessions: parseFloat((document.getElementById("sessionsPerDay") as HTMLInputElement).value) || 0,
      days: parseFloat((document.getElementById("daysPerMonth") as HTMLInputElement).value) || 0,
      machines: parseInt((document.getElementById("numMachines") as HTMLInputElement).value) || 1,
    };
  }

  function calculate() {
    const { price, sessions, days, machines } = getInputs();

    const grossMonthly = price * sessions * days;
    const resonaraShare = grossMonthly * 0.2;
    const netMonthly = grossMonthly * 0.8;
    const netAnnual = netMonthly * 12;
    const totalAnnual = netAnnual * machines;

    // Payback: how many months to earn back $4000 via Resonara share credits
    const creditPool = 4000 * machines;
    const monthlyShare = resonaraShare * machines;
    const paybackMonths = monthlyShare > 0 ? creditPool / monthlyShare : Infinity;

    // Update hero
    document.getElementById("netMonthlyPerMachine")!.textContent = fmt(netMonthly);
    document.getElementById("netMonthly2")!.textContent = fmt(netMonthly);
    document.getElementById("grossMonthly")!.textContent = fmt(grossMonthly);
    document.getElementById("resonaraShare")!.textContent = fmt(resonaraShare);
    document.getElementById("netAnnual")!.textContent = fmt(netAnnual);
    document.getElementById("totalAnnual")!.textContent = fmt(totalAnnual);
    document.getElementById("revenueFormula")!.textContent = `${sessions} sess × ${days} days × $${price}`;

    // Payback
    const paybackBar = document.getElementById("paybackBar") as HTMLElement;
    const paybackMonthsEl = document.getElementById("paybackMonths")!;
    const paybackNote = document.getElementById("paybackNote")!;

    if (paybackMonths === Infinity || isNaN(paybackMonths)) {
      paybackMonthsEl.textContent = "—";
      paybackNote.textContent = "Enter session values to calculate";
      paybackBar.style.width = "0%";
    } else {
      paybackMonthsEl.textContent = paybackMonths.toFixed(1);
      paybackBar.style.width = Math.min(100, (12 / paybackMonths) * 100) + "%";

      if (paybackMonths <= 3) {
        paybackNote.textContent = "Excellent — recover investment in under 3 months";
      } else if (paybackMonths <= 6) {
        paybackNote.textContent = "Strong — full recovery within 6 months";
      } else if (paybackMonths <= 12) {
        paybackNote.textContent = "Solid — recovery within first year";
      } else {
        paybackNote.textContent = "Consider increasing sessions or price per session";
      }
    }

    // Table
    const tbody = document.getElementById("tableBody")!;
    const rows = [
      { label: "1 Month", mul: 1 },
      { label: "3 Months", mul: 3 },
      { label: "6 Months", mul: 6 },
      { label: "1 Year", mul: 12 },
      { label: "3 Years", mul: 36 },
    ];

    tbody.innerHTML = rows
      .map((r, i) => {
        const gross = grossMonthly * r.mul * machines;
        const share = gross * 0.2;
        const net = gross * 0.8;
        const isLast = i === rows.length - 1;
        return `<tr class="${isLast ? "border-t border-border" : ""}">
          <td class="px-6 py-3 text-left ${isLast ? "text-sm font-semibold" : "text-xs"} tracking-widest uppercase text-muted-foreground">${r.label}</td>
          <td class="px-6 py-3 text-right ${isLast ? "text-xl font-bold text-foreground" : "text-base font-medium text-foreground"}">${fmt(gross)}</td>
          <td class="px-6 py-3 text-right ${isLast ? "text-xl font-bold text-muted-foreground" : "text-base font-medium text-muted-foreground"}">${fmt(share)}</td>
          <td class="px-6 py-3 text-right ${isLast ? "text-xl font-bold text-foreground" : "text-base font-medium text-foreground"}">${fmt(net)}</td>
        </tr>`;
      })
      .join("");
  }

  // Sync inputs & sliders
  function syncSlider(inputId: string, sliderId: string) {
    const input = document.getElementById(inputId) as HTMLInputElement;
    const slider = document.getElementById(sliderId) as HTMLInputElement;

    const updateSliderBg = () => {
      const min = parseFloat(slider.min);
      const max = parseFloat(slider.max);
      const val = parseFloat(slider.value);
      const pct = ((val - min) / (max - min)) * 100;
      slider.style.background = `linear-gradient(90deg, var(--accent) ${pct}%, var(--muted) ${pct}%)`;
    };

    input.addEventListener("input", () => {
      slider.value = input.value;
      updateSliderBg();
      calculate();
    });
    slider.addEventListener("input", () => {
      input.value = slider.value;
      updateSliderBg();
      calculate();
    });
    updateSliderBg();
  }

  syncSlider("pricePerSession", "ppsSlider");
  syncSlider("sessionsPerDay", "spdSlider");
  syncSlider("daysPerMonth", "dpmSlider");

  // Machine buttons
  document.querySelectorAll(".machine-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".machine-btn").forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      (document.getElementById("numMachines") as HTMLInputElement).value = (btn as HTMLElement).dataset.val!;
      calculate();
    });
  });

  // Initial calculation
  calculate();
</script>
