---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found | Resonara" description="The page you were looking for could not be found." noindex>
  <section class="page-hero nf">
    <div class="wrap">
      <span class="eyebrow">Error 404</span>
      <h1>This page has fallen silent.</h1>
      <p class="lede">You may have followed a broken link, or entered an address that doesn't exist on this site. The practice always begins again.</p>
      <div class="row">
        <a href="/" class="btn btn-primary">Return home</a>
        <a href="/how-it-works/" class="btn btn-ghost">How it works →</a>
      </div>
    </div>
  </section>
</SiteLayout>
