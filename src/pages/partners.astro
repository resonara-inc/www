---
import DarkLayout from "../layouts/DarkLayout.astro";
import { Image } from "astro:assets";
import ResonaraSpa from "../assets/ResonaraSpa.png";
import ResonaraBoxFinak from "../assets/ResonaraBoxFinak.png";
import LoungeFloor3 from "../assets/LoungeFloor3.png";
---

<DarkLayout title="Resonara — For Spas & Partners" description="The perfect union of spiritual intent and scientific precision. Partner with Resonara.">
  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
  <div class="hero-bg">
    <Image
      src={ResonaraSpa}
      alt="Resonara singing bowls — luxury wellness suite"
      class="hero-bg-img"
      width={1400}
      quality={85}
      loading="eager"
    />
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <p class="hero-eyebrow reveal">For Spas, Gyms &amp; Corporate Wellness</p>
    <h1 class="hero-title reveal d1">
      The perfect union of<br />
      <span>spiritual intent</span><br />
      and scientific precision.
    </h1>
    <p class="hero-sub reveal d2">
      Sound, when calibrated precisely, becomes medicine.<br />
      Fully automated. Zero staff required.
    </p>
    <div class="hero-cta-row reveal d3">
      <a href="/roi-calculator" class="cta-btn"><span>Calculate Your ROI &nbsp;→</span></a>
      <a href="#enquire" class="cta-btn outline"><span>Enquire Now &nbsp;→</span></a>
    </div>
  </div>
</section>

  <div class="ornament reveal" style="text-align: center;"><span>✦</span></div>

  <!-- ═══════════ PARTNER VERTICALS ═══════════ -->
  <section class="who-section">
    <div class="who-inner">
      <p class="section-label reveal">Who Partners With Resonara</p>
      <h2 class="section-heading reveal d1">Three verticals. <span>One premium offering.</span></h2>
      <p class="section-sub reveal d2">Fully automated. Zero staff overhead. Resonara installs as a revenue-generating treatment suite — not a wellness accessory.</p>
      <div class="partner-grid">
        <div class="partner-card reveal d1">
          <div class="partner-icon">🛎</div>
          <p class="partner-name">Luxury Spas &amp; Wellness Centres</p>
          <p class="partner-desc">A signature treatment you can charge a premium for — with zero additional staff. No other spa in your market offers verified automated acoustic therapy.</p>
        </div>
        <div class="partner-card reveal d2">
          <div class="partner-icon">🏋</div>
          <p class="partner-name">High-Performance Gyms &amp; Studios</p>
          <p class="partner-desc">
            Recovery is the new training. A fully automated Resonara suite runs between client sessions with no therapist needed — driving premium add-on revenue around the clock.
          </p>
        </div>
        <div class="partner-card reveal d3">
          <div class="partner-icon">🏢</div>
          <p class="partner-name">Corporate Wellness &amp; Executive Suites</p>
          <p class="partner-desc">
            The boardroom runs on the nervous systems inside it. Resonara delivers measurable executive recovery — automated, on-demand, with HRV data to prove programme efficacy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ STATS STRIP ═══════════ -->
  <div class="diff-strip">
    <div class="diff-inner">
      <div class="diff-item reveal"><span class="diff-val">10 min</span><span class="diff-label">Automated session duration</span></div>
      <div class="diff-item reveal d1"><span class="diff-val">Zero</span><span class="diff-label">Staff required per session</span></div>
      <div class="diff-item reveal d2"><span class="diff-val">20%</span><span class="diff-label">Resonara share — you keep 80%</span></div>
      <div class="diff-item reveal d3"><span class="diff-val">USPTO</span><span class="diff-label">Patent filed — no competitor can replicate</span></div>
    </div>
  </div>

  <div class="ornament reveal"><span>✦</span></div>

  <!-- ═══════════ PARTNER PACKAGE SPLIT ═══════════ -->
  <section class="split-section">
    <div class="img-side has-img reveal-left">
      <Image src={LoungeFloor3} alt="Resonara automated treatment unit — artisan bowl, precision engineered" class="panel-img" width={900} quality={75} loading="lazy" />
      <div class="img-overlay"></div>
    </div>
    <div class="text-side">
      <p class="section-label reveal" style="text-align:left">The Partner Package</p>
      <h2 class="section-heading reveal d1" style="text-align:left">THE GROUP SESSION.<br /><span>One room.One frequency. Everyone resets.</span></h2>
      <div class="pull-quote reveal d2"><p>Your guests close their eyes. Resonara does the rest.</p></div>
      <div class="includes-list reveal d3">
        <div class="include-item">
          <div class="include-dot"></div>
          <div class="include-text"><strong>Resonara Automated Treatment Unit</strong> — self-operating, zero therapist required</div>
        </div>
        <div class="include-item">
          <div class="include-dot"></div>
          <div class="include-text"><strong>Acoustically Verified Bowl Set</strong> — artisan-hammered, frequency-mapped, RNI certified</div>
        </div>
        <div class="include-item">
          <div class="include-dot"></div>
          <div class="include-text"><strong>Certificate of Acoustic Authenticity</strong> — display-ready, builds client confidence</div>
        </div>
        <div class="include-item">
          <div class="include-dot"></div>
          <div class="include-text"><strong>Group Sound Bath Protocol</strong> — automated, therapist-free, runs up to 6 participants simultaneously</div>
        </div>
        <div class="include-item">
          <div class="include-dot"></div>
          <div class="include-text"><strong>Zero Coordination Required</strong> guests arrive, sit, close their eyes. Resonara does the rest.</div>
        </div>
      </div>
      <p class="italic-note reveal d4">Automated sound therapy system. No competitor can offer this combination of automation, acoustic certification, and biometric validation.</p>
    </div>
  </section>

  <div class="ornament reveal"><span>✦</span></div>

  <!-- ═══════════ ROI CALCULATOR LINK ═══════════ -->
  <section class="roi-cta-section">
    <div class="roi-cta-inner">
      <p class="section-label reveal">Your Earning Potential</p>
      <h2 class="section-heading reveal d1">Model your <span>ROI</span> before you commit.</h2>
      <p class="section-sub reveal d2">Enter your price per session, sessions per day, and operating days to see your net earnings projection — per machine, per month.</p>
      <div class="reveal d3">
        <a href="/roi-calculator" class="cta-btn"><span>Open ROI Calculator &nbsp;→</span></a>
      </div>
      <p class="roi-note reveal d4">$2,000 partner fee · $4,000 refundable revenue credit · You keep 80% of all session revenue</p>
    </div>
  </section>

  <div class="ornament reveal"><span>✦</span></div>

  <!-- ═══════════ TESTIMONIALS ═══════════ -->
  <section class="testimonial-strip">
    <div class="testimonial-inner">
      <p class="section-label reveal" style="margin-bottom:2rem">From Our Partners</p>
      <div class="testimonial-grid">
        <div class="testi-card reveal">
          <p class="testi-quote">"We introduced Resonara as a signature add-on. Within three months it became our highest-rated experience — and our highest-margin one. Zero extra staff."</p>
          <p class="testi-attr">Spa Director &middot; Five-Star Resort, Singapore</p>
        </div>
        <div class="testi-card reveal d1">
          <p class="testi-quote">"Our members call it the best recovery tool we've added in five years. The science framing makes it credible to a performance-focused audience."</p>
          <p class="testi-attr">General Manager &middot; Premium Gym, Dubai</p>
        </div>
        <div class="testi-card reveal d2">
          <p class="testi-quote">"The certificate was the detail that sealed it for our executive clients. They're used to precision. Resonara speaks their language."</p>
          <p class="testi-attr">Head of Wellness &middot; Corporate Campus, London</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ CLOSING ═══════════ -->
  <section class="closing-band" id="enquire">
    <p class="closing-main reveal">Ready to bring Resonara<br />to your space?</p>
    <p class="closing-sub reveal d1">We work with a limited number of partners in each market.<br />Enquire now to check availability in your region.</p>
    <div class="cta-row reveal d2">
      <a href="mailto:partners@resonara.com" class="cta-btn"><span>Enquire Now &nbsp;→</span></a>
      <a href="/roi-calculator" class="cta-btn outline"><span>Calculate ROI &nbsp;↗</span></a>
    </div>
  </section>
</DarkLayout>

<style>
  /* ── HERO ── */
  .hero {
  position: relative;
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  inset: 0;
  overflow: hidden;
}
.hero-bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
  opacity: 0.72;
  filter: brightness(0.85) saturate(1.05);
}
.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(14, 12, 9, 0.35) 0%,
    rgba(14, 12, 9, 0.45) 50%,
    rgba(14, 12, 9, 0.75) 100%
  );
}
.hero-content {
  position: relative;
  z-index: 2;
  padding: clamp(6rem, 10vw, 9rem) clamp(2rem, 6vw, 5rem) clamp(4rem, 6vw, 5rem);
  max-width: 820px;
  margin: 0 auto;
  text-align: center;
}
.hero-eyebrow {
  font-family: "Cinzel", serif;
  font-size: clamp(0.7rem, 1.5vw, 0.88rem);
  letter-spacing: 0.42em;
  color: var(--gold);
  margin-bottom: 1.4rem;
  opacity: 0.95;
  text-shadow: 0 1px 8px rgba(0,0,0,0.6);
}
.hero-title {
  font-family: "Cinzel", serif;
  font-size: clamp(1.8rem, 5vw, 3.8rem);
  font-weight: 400;
  line-height: 1.25;
  color: var(--parchment);
  letter-spacing: 0.04em;
  margin-bottom: 1.6rem;
  text-shadow: 0 2px 24px rgba(0,0,0,0.7), 0 1px 6px rgba(0,0,0,0.9);
}
.hero-title span {
  color: var(--gold);
}
.hero-sub {
  font-size: clamp(1.05rem, 2vw, 1.35rem);
  font-style: italic;
  color: var(--gold-pale);
  opacity: 0.9;
  line-height: 1.9;
  margin-bottom: 2.5rem;
  text-shadow: 0 1px 12px rgba(0,0,0,0.7);
}
.hero-cta-row {
  display: flex;
  gap: 1.2rem;
  justify-content: center;
  flex-wrap: wrap;
}
@media (max-width: 800px) {
  .hero-content {
    padding-top: clamp(5rem, 15vw, 7rem);
  }
}

  /* ── WHO ── */
  .who-section {
    background: var(--dark-mid);
    padding: clamp(3rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
  }
  .who-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .partner-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  @media (max-width: 900px) {
    .partner-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 540px) {
    .partner-grid {
      grid-template-columns: 1fr;
    }
  }
  .partner-card {
    border: 1px solid rgba(201, 168, 76, 0.2);
    padding: 2rem 1.8rem;
    background: rgba(201, 168, 76, 0.03);
    transition:
      border-color 0.3s,
      background 0.3s;
  }
  .partner-card:hover {
    border-color: rgba(201, 168, 76, 0.45);
    background: rgba(201, 168, 76, 0.07);
  }
  .partner-icon {
    font-size: 1.8rem;
    margin-bottom: 1rem;
    opacity: 0.8;
  }
  .partner-name {
    font-family: "Cinzel", serif;
    font-size: clamp(0.82rem, 1.5vw, 1rem);
    letter-spacing: 0.2em;
    color: var(--gold);
    margin-bottom: 0.8rem;
  }
  .partner-desc {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.8;
    color: rgba(250, 245, 233, 0.7);
  }

  /* ── STATS STRIP ── */
  .diff-strip {
    background: linear-gradient(135deg, rgba(201, 168, 76, 0.1), rgba(201, 168, 76, 0.03));
    border-top: 1px solid rgba(201, 168, 76, 0.22);
    border-bottom: 1px solid rgba(201, 168, 76, 0.22);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 5vw, 4rem);
  }
  .diff-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }
  @media (max-width: 800px) {
    .diff-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  .diff-val {
    font-family: "Cinzel", serif;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    color: var(--gold);
    font-weight: 600;
    display: block;
    margin-bottom: 0.4rem;
  }
  .diff-label {
    font-size: clamp(0.85rem, 1.4vw, 1rem);
    color: rgba(250, 245, 233, 0.55);
    font-style: italic;
    line-height: 1.6;
  }

  /* ── PARTNER PACKAGE SPLIT ── */
  .split-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 75vh;
    align-items: stretch;
    background: var(--dark);
  }
  @media (max-width: 800px) {
    .split-section {
      grid-template-columns: 1fr;
      min-height: unset;
    }
  }
  .img-side {
    position: relative;
    overflow: hidden;
    min-height: 50vh;
    background: linear-gradient(135deg, rgba(201, 168, 76, 0.07), var(--dark-mid));
  }
  .panel-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    z-index: 0;
  }
  .img-overlay {
    z-index: 1;
  }
  .has-img::after {
    display: none;
  }
  .img-side::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 1px solid rgba(201, 168, 76, 0.15);
    box-shadow:
      0 0 0 50px rgba(201, 168, 76, 0.04),
      0 0 0 100px rgba(201, 168, 76, 0.025);
  }
  .img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent, rgba(14, 12, 9, 0.5));
  }
  @media (max-width: 800px) {
    .img-overlay {
      background: linear-gradient(to bottom, transparent, rgba(14, 12, 9, 0.65));
    }
  }
  .text-side {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 4.5rem);
    background: linear-gradient(135deg, rgba(201, 168, 76, 0.05), var(--dark-mid));
  }
  .includes-list {
    margin: 1.8rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .include-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .include-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
    margin-top: 0.55rem;
    flex-shrink: 0;
  }
  .include-text {
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    color: rgba(250, 245, 233, 0.78);
    line-height: 1.7;
  }
  .include-text strong {
    font-weight: 600;
    color: var(--parchment);
  }
  .italic-note {
    font-style: italic;
    color: rgba(201, 168, 76, 0.65);
    font-size: clamp(0.9rem, 1.4vw, 1.05rem);
    line-height: 1.7;
    margin-top: 0.5rem;
  }

  /* ── ROI CTA ── */
  .roi-cta-section {
    background: var(--dark-mid);
    padding: clamp(3.5rem, 8vw, 6rem) clamp(2rem, 5vw, 4rem);
    text-align: center;
  }
  .roi-cta-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .roi-note {
    font-family: "Cinzel", serif;
    font-size: clamp(0.75rem, 1.2vw, 0.88rem);
    letter-spacing: 0.2em;
    color: rgba(201, 168, 76, 0.45);
    margin-top: 2rem;
    line-height: 1.8;
  }

  /* ── TESTIMONIALS ── */
  .testimonial-strip {
    background: var(--dark);
    border-top: 1px solid rgba(201, 168, 76, 0.1);
    padding: clamp(3rem, 6vw, 5rem) clamp(2rem, 5vw, 4rem);
  }
  .testimonial-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .testimonial-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 800px) {
    .testimonial-grid {
      grid-template-columns: 1fr;
    }
  }
  .testi-card {
    padding: 1.8rem;
    border: 1px solid rgba(201, 168, 76, 0.15);
    background: rgba(201, 168, 76, 0.02);
  }
  .testi-quote {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    font-style: italic;
    color: rgba(250, 245, 233, 0.78);
    line-height: 1.85;
    margin-bottom: 1.2rem;
  }
  .testi-attr {
    font-family: "Cinzel", serif;
    font-size: clamp(0.65rem, 1.1vw, 0.78rem);
    letter-spacing: 0.22em;
    color: rgba(201, 168, 76, 0.55);
  }

  /* ── CLOSING ── */
  .closing-band {
    text-align: center;
    padding: clamp(4rem, 8vw, 7rem) clamp(2rem, 5vw, 4rem);
    background: linear-gradient(to bottom, var(--dark-mid), var(--dark));
  }
  .closing-main {
    font-family: "Cinzel", serif;
    font-size: clamp(1.2rem, 3vw, 2rem);
    color: var(--gold);
    letter-spacing: 0.06em;
    line-height: 1.5;
    margin-bottom: 1rem;
  }
  .closing-sub {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-style: italic;
    color: rgba(250, 245, 233, 0.6);
    margin-bottom: 2.5rem;
    line-height: 1.7;
  }
  .cta-row {
    display: flex;
    gap: 1.2rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
