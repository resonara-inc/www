---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="App support | Resonara" description="Get help with your Resonara app.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Help centre</span>
      <h1>Support</h1>
      <p class="lede">We're here to help. Reach out and we'll respond within one business day.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="ways">
        <div class="way">
          <span class="status">General enquiries</span>
          <p class="muted">Questions about the Resonara app, your account, or our sound therapy protocol.</p>
          <a href="mailto:support@resonara.com">support@resonara.com</a>
        </div>
        <div class="way">
          <span class="status">Billing &amp; subscriptions</span>
          <p class="muted">Help with charges, refund requests, or managing your subscription.</p>
          <a href="mailto:billing@resonara.com">billing@resonara.com</a>
          <p class="note">
            For app store purchases, refunds are handled directly by <a href="https://support.apple.com/en-gb/118223" target="_blank" rel="noopener noreferrer">Apple</a> or <a
              href="https://support.google.com/googleplay/answer/2479637"
              target="_blank"
              rel="noopener noreferrer">Google Play</a
            >.
          </p>
        </div>
        <div class="way">
          <span class="status">Privacy &amp; data</span>
          <p class="muted">Account deletion requests, data access, or questions about our Privacy Policy.</p>
          <a href="mailto:privacy@resonara.com">privacy@resonara.com</a>
        </div>
        <div class="way">
          <span class="status">Business &amp; partnerships</span>
          <p class="muted">Corporate wellness programmes, spa integrations, and enterprise enquiries.</p>
          <a href="/waitlist/" class="link-arrow">Join the waitlist →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band band-surface" style="border-top:1px solid var(--line)">
    <div class="wrap split">
      <div class="section-head" style="margin:0"><span class="eyebrow">App questions</span><h2>Frequently asked questions</h2></div>
      <div class="faq-list">
        <details>
          <summary>How do I cancel my subscription?</summary>
          <div class="ans">
            <p>
              Subscriptions are managed through the app store you used to purchase. On iPhone, go to Settings → Apple ID → Subscriptions. On Android, open the Google Play Store → Profile → Payments &amp;
              subscriptions → Subscriptions. Select Resonara and tap Cancel.
            </p>
          </div>
        </details>
        <details>
          <summary>How do I delete my account and data?</summary>
          <div class="ans">
            <p>
              Email <a href="mailto:privacy@resonara.com">privacy@resonara.com</a> with the subject line "Delete my account" from the email address associated with your account. We will process your
              request within 30 days.
            </p>
          </div>
        </details>
        <details>
          <summary>The app isn't working correctly — what should I do?</summary>
          <div class="ans">
            <p>
              Try closing and reopening the app, then ensure you have the latest version installed. If the issue persists, email <a href="mailto:support@resonara.com">support@resonara.com</a> with
              your device model, operating system version, and a description of the problem.
            </p>
          </div>
        </details>
        <details>
          <summary>Are my health and wellness sessions stored on your servers?</summary>
          <div class="ans">
            <p>
              Session data is stored locally on your device by default. We do not collect or transmit audio or biometric data. Please see our <a href="/privacy/">Privacy Policy</a> for full details.
            </p>
          </div>
        </details>
        <details>
          <summary>Is Resonara suitable for people with medical conditions?</summary>
          <div class="ans">
            <p>
              Resonara is a general wellness product and is not a medical device. Please consult your healthcare provider before use if you have a medical condition, particularly epilepsy or other
              sound-sensitivity disorders.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>
</SiteLayout>
