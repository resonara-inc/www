---
import DarkLayout from "../layouts/DarkLayout.astro";
import { Image } from "astro:assets";
import BowlCertificateFinal from "../assets/BowlCertificateFinal.png";
import ResonaraBowlCraft from "../assets/ResonaraBowlCraft.png";
import ResonaraBowlMallet from "../assets/ResonaraBowlMallet.png";
import ResonaraBowlMalletStrikes from "../assets/ResonaraBowlMalletstrikes.mp4";
---

<DarkLayout title="Resonara — The Science" description="Frequency is not mysticism. It is mathematics. The acoustic science behind Resonara.">
  <!-- ═══════════ HERO ═══════════ -->
  <section class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow reveal">Chemistry of the bowl. Physics of sound.<br /> Mathematics of frequency.Biology of the mind.<br />
Stillness of the whole.</p>
      <p class="hero-sub reveal d2">
        Every bowl is engineered to a precise acoustic specification. Every strike is calibrated to produce a measurable neurological response. 
      </p>
    </div>
  </section>

<!-- ═══════════ STRIKE VIDEO ═══════════ -->
<section class="video-section">
  <video
    src="/ResonaraBowlMalletstrikes.mp4"
    controls
    loop
    playsinline
    class="strike-video"
  ></video>
</section>

  <div class="ornament reveal"><span>✦</span></div>

  <!-- ═══════════ SECTION 01 — CRAFTSMANSHIP ═══════════ -->
  <section class="science-section">
    <div class="img-side img-side--craft has-img reveal-left">
      <Image src={ResonaraBowlCraft} alt="Resonara bowl — artisan-forged, 7-metal alloy, acoustically certified" class="panel-img" width={900} quality={75} />
      <div class="img-overlay overlay-right"></div>
    </div>
    <div class="text-side gold-tint">
      <p class="section-num reveal">01</p>
      <p class="section-label reveal d1">The Craftsmanship</p>
      <h2 class="section-heading reveal d2">Forged with the precision<br />of a <span>master.</span></h2>
      <p class="body-p reveal d2">Every Resonara bowl is crafted to the same exacting standard as a Japanese katana — where a single deviation in geometry changes everything.</p>
      <p class="body-p reveal d3">
        The wall thickness, diameter, alloy composition, and hammer pattern are not aesthetic decisions. They are acoustic ones. Each determines the frequency the bowl will produce, and how long it
        will sustain.
      </p>
      <div class="pull-quote reveal d3">
        <p>Not art. Not ritual.<br /><em>Science, held in two hands.</em></p>
      </div>
      <div class="stat-row reveal d4">
        <div class="stat-pill">
          <span class="stat-val">7-Metal</span>
          <span class="stat-label">Alloy Composition</span>
        </div>
        <div class="stat-pill">
          <span class="stat-val">±2Hz</span>
          <span class="stat-label">Frequency Tolerance</span>
        </div>
        <div class="stat-pill">
          <span class="stat-val">5</span>
          <span class="stat-label">Geometries Tested</span>
        </div>
      </div>
    </div>
  </section>

  <div class="ornament reveal"><span>✦</span></div>

   <!-- ═══════════ SECTION 02 — THE INSTRUMENT ═══════════ -->
  <section class="science-section reverse">
    <div class="text-side">
      <p class="section-num reveal">02</p>
      <p class="section-label reveal d1">The Instrument</p>
      <h2 class="section-heading reveal d2">Artisan-hammered.<br /><span>Acoustically verified.</span></h2>
      <p class="body-p reveal d2">
        The Resonara bowl and its calibrated mallet are engineered together. Strike velocity, mallet density, and contact point are not incidental — they determine the amplitude modulation that drives
        therapeutic effect.
      </p>
      <p class="body-p reveal d3">The QR code on each bowl links directly to its acoustic profile — your bowl's full frequency map, available anytime.</p>
      <div class="pull-quote reveal d3">
        <p><em>Strike once. The rest is physics.</em></p>
      </div>
      <div class="stat-row reveal d4">
        <div class="stat-pill">
          <span class="stat-val">180Hz</span>
          <span class="stat-label">Artisan Edition Fundamental</span>
        </div>
        <div class="stat-pill">
          <span class="stat-val">EEG</span>
          <span class="stat-label">Biometric Validated</span>
        </div>
        <div class="stat-pill">
          <span class="stat-val">USPTO</span>
          <span class="stat-label">Patent Filed</span>
        </div>
      </div>
    </div>
    <div class="img-side img-side--mallet has-img reveal-right">
      <Image src={ResonaraBowlMallet} alt="Resonara bowl and calibrated mallet — precision instrument" class="panel-img" width={900} quality={75} loading="lazy" />
      <div class="img-overlay overlay-left"></div>
    </div>
  </section>

  <div class="ornament reveal"><span>✦</span></div>

 <!-- ═══════════ RNI — FULL WIDTH ═══════════ -->
  <section class="rni-section">
    <div class="rni-content">
      <p class="section-label reveal">The Resonara Neuromodulation Index</p>
      <h2 class="rni-heading reveal d1">Every bowl carries a unique<br /><span>acoustic signature.</span></h2>
      <p class="body-p rni-para reveal d2">
        The RNI maps each bowl's resonance profile across the four primary brainwave states. Your bowl is calibrated to a specific therapeutic protocol — not randomly assigned, but precisely matched.
      </p>
      <div class="freq-bands reveal d3">
        <div class="freq-band">
          <p class="freq-name">DELTA</p>
          <p class="freq-hz">0.5 – 4 Hz</p>
          <p class="freq-desc">Deep restoration. Dreamless sleep. Full system recovery.</p>
        </div>
        <div class="freq-band">
          <p class="freq-name">THETA</p>
          <p class="freq-hz">4 – 8 Hz</p>
          <p class="freq-desc">Deep relaxation. Creative insight. The edge of sleep.</p>
        </div>
        <div class="freq-band">
          <p class="freq-name">ALPHA</p>
          <p class="freq-hz">8 – 13 Hz</p>
          <p class="freq-desc">Calm focus. Present awareness. Stress dissolution.</p>
        </div>
        <div class="freq-band">
          <p class="freq-name">BETA</p>
          <p class="freq-hz">13 – 30 Hz</p>
          <p class="freq-desc">Alert clarity. Active thinking. Optimal performance.</p>
        </div>
      </div>
      <p class="rni-validation reveal d4">Validated with Muse 2 EEG and Polar H10 HRV biometric testing.</p>
    </div>
  </section>

  <div class="ornament reveal"><span>✦</span></div>

  <!-- ═══════════ SECTION 03 — THE TRADITION ═══════════ -->
  <section class="science-section">
    <div class="img-side img-side--tradition has-img reveal-left">
      <Image src={BowlCertificateFinal} alt="Resonara — where ancient tradition meets modern science" class="panel-img" width={900} quality={75} loading="lazy" />
      <div class="img-overlay overlay-right"></div>
    </div>
    <div class="text-side gold-tint">
      <p class="section-num reveal">03</p>
      <p class="section-label reveal d1">The Tradition</p>
      <h2 class="section-heading reveal d2">Three thousand years<br />of <span>documented evidence.</span></h2>
      <p class="body-p reveal d2">
        Nāda yoga — the yoga of sound — predates the Vedic texts that first recorded it. For millennia, practitioners understood that specific frequencies could shift the quality of attention, calm an
        agitated nervous system, and return the body to a state of deep coherence.
      </p>
      <p class="body-p reveal d3">
        Modern science has given us the vocabulary to describe what the ancients already knew in practice: <em
          >acoustic entrainment, parasympathetic activation, delta-wave induction, HRV elevation.</em
        >
      </p>
      <div class="pull-quote reveal d4">
        <p>The practitioner who first struck a bowl intended to heal.<br />We have simply added the instruments to prove it.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════ CERT BAND ═══════════ -->
  <div class="cert-band reveal">
    <p class="cert-label">Certificate of Acoustic Authenticity</p>
    <p class="cert-headline">Every bowl is individually tested, mapped, and certified.</p>
    <div class="cert-details">
      <div class="cert-row">
        <span class="cert-key">Acoustic Testing</span>
        <span class="cert-val">Frequency analysis by calibrated measurement instrument</span>
      </div>
      <div class="cert-row">
        <span class="cert-key">Biometric Validation</span>
        <span class="cert-val">EEG (Muse 2) and HRV (Polar H10) protocol testing</span>
      </div>
      <div class="cert-row">
        <span class="cert-key">RNI Mapping</span>
        <span class="cert-val">Full resonance profile across Delta, Theta, Alpha, Beta</span>
      </div>
      <div class="cert-row">
        <span class="cert-key">Patent Status</span>
        <span class="cert-val">USPTO — Filed & Pending</span>
      </div>
    </div>
  </div>

  <!-- ═══════════ CLOSING ═══════════ -->
  <section class="closing">
    <div class="closing-inner">
      <p class="section-label reveal">What This Means For You</p>
      <p class="closing-main reveal d1">Ten minutes.<br /><span>Measured. Repeatable. Yours.</span></p>
      <p class="closing-sub reveal d2">
        Not approximate. Not anecdotal. Not dependent on how the practitioner slept last night. Resonara delivers the same quality of resonance, to the same specification, every single time.
      </p>
      <a href="/who-its-for" class="cta-btn reveal d3"><span>See Who It's For &nbsp;→</span></a>
    </div>
  </section>
</DarkLayout>

<style>
  /* ── HERO ── */
.video-section {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 2rem 1rem;  /* top right/left bottom */
}

.strike-video {
  width: 100%;
  height: auto;
  border-radius: 8px;
  display: block;
}
  .hero {
    min-height: unset;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    margin: 0 auto;
    padding: 2rem 1.5rem 1rem;;
    background: linear-gradient(to bottom, var(--dark) 0%, var(--dark-mid) 100%);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(201, 168, 76, 0.06) 0%, transparent 70%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }
  .hero-eyebrow {
    font-family: "Cinzel", serif;
    font-size: clamp(1rem, 8vw, 1rem);
    letter-spacing: 0.42em;
    color: var(--gold);
    margin-top: 1rem;
    opacity: 0.85;
  }
  .hero-title {
    font-family: "Cinzel", serif;
    font-size: clamp(1.8rem, 5.5vw, 4rem);
    font-weight: 400;
    line-height: 1.2;
    color: var(--parchment);
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }
  .hero-title span {
    color: var(--gold);
  }
  .hero-sub {
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-style: italic;
    color: rgba(250, 245, 233, 0.7);
    line-height: 1.8;
    max-width: 620px;
    margin: 0 auto;
  }

  /* ── SCIENCE SPLIT SECTIONS ── */
  .science-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
    align-items: stretch;
  }
  @media (max-width: 800px) {
    .science-section {
      grid-template-columns: 1fr;
      min-height: unset;
    }
    .science-section .img-side {
      order: 1;
    }
    .science-section .text-side {
      order: 2;
    }
    .science-section.reverse .img-side {
      order: 1;
    }
    .science-section.reverse .text-side {
      order: 2;
    }
  }
  .img-side {
    position: relative;
    overflow: hidden;
    min-height: 50vh;
    background: linear-gradient(135deg, rgba(201, 168, 76, 0.06), var(--dark-mid));
  }
  .img-side::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 1px solid rgba(201, 168, 76, 0.15);
    box-shadow:
      0 0 0 50px rgba(201, 168, 76, 0.04),
      0 0 0 100px rgba(201, 168, 76, 0.025);
  }
  .panel-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    z-index: 0;
  }
  .img-overlay {
    z-index: 1;
  }
  .has-img::after {
    display: none;
  }
  @media (max-width: 800px) {
    .img-side {
      min-height: 50vw;
      max-height: 380px;
    }
  }
  .img-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .overlay-right {
    background: linear-gradient(to right, transparent, rgba(14, 12, 9, 0.5));
  }
  .overlay-left {
    background: linear-gradient(to left, transparent, rgba(14, 12, 9, 0.5));
  }
  @media (max-width: 800px) {
    .overlay-right,
    .overlay-left {
      background: linear-gradient(to bottom, transparent, rgba(14, 12, 9, 0.65));
    }
  }
  .text-side {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.8rem, 5vw, 4.5rem);
    background: var(--dark-mid);
  }
  .text-side.gold-tint {
    background: linear-gradient(135deg, rgba(201, 168, 76, 0.06), var(--dark-mid));
  }

  /* ── TYPOGRAPHIC HELPERS ── */
  .section-num {
    font-family: "Cinzel", serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: rgba(201, 168, 76, 0.08);
    line-height: 1;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-bottom: -0.5rem;
    display: block;
  }
  .stat-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 1.8rem 0;
  }
  .stat-pill {
    border: 1px solid rgba(201, 168, 76, 0.3);
    padding: 0.7rem 1.2rem;
    background: rgba(201, 168, 76, 0.05);
  }
  .stat-pill .stat-val {
    font-family: "Cinzel", serif;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--gold);
    font-weight: 600;
    letter-spacing: 0.05em;
    display: block;
  }
  .stat-pill .stat-label {
    font-size: clamp(0.72rem, 1.2vw, 0.85rem);
    color: rgba(250, 245, 233, 0.55);
    letter-spacing: 0.12em;
    font-style: italic;
  }

  /* ── RNI SECTION ── */
  .rni-section {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(201, 168, 76, 0.09), var(--dark-mid) 60%, var(--dark));
    border-top: 1px solid rgba(201, 168, 76, 0.18);
    border-bottom: 1px solid rgba(201, 168, 76, 0.18);
    padding: clamp(3.5rem, 8vw, 7rem) clamp(2rem, 6vw, 5rem);
  }
  .rni-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  .rni-heading {
    font-family: "Cinzel", serif;
    font-size: clamp(1.3rem, 3vw, 2.2rem);
    font-weight: 600;
    color: var(--parchment);
    letter-spacing: 0.05em;
    line-height: 1.35;
    margin-bottom: 1.5rem;
  }
  .rni-heading span {
    color: var(--gold);
  }
  .rni-para {
    max-width: 680px;
    margin: 0 auto 1.5rem;
    text-align: center;
  }
  .freq-bands {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.8rem 0;
    text-align: left;
  }
  @media (max-width: 500px) {
    .freq-bands {
      grid-template-columns: 1fr;
    }
  }
  .freq-band {
    border: 1px solid rgba(201, 168, 76, 0.2);
    padding: 1rem 1.2rem;
    background: rgba(201, 168, 76, 0.04);
    transition:
      border-color 0.3s,
      background 0.3s;
  }
  .freq-band:hover {
    border-color: rgba(201, 168, 76, 0.5);
    background: rgba(201, 168, 76, 0.07);
  }
  .freq-name {
    font-family: "Cinzel", serif;
    font-size: clamp(0.75rem, 1.3vw, 0.88rem);
    color: var(--gold);
    letter-spacing: 0.18em;
    margin-bottom: 0.3rem;
  }
  .freq-hz {
    font-size: clamp(0.82rem, 1.4vw, 0.95rem);
    color: rgba(201, 168, 76, 0.55);
    font-style: italic;
    margin-bottom: 0.5rem;
  }
  .freq-desc {
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: rgba(250, 245, 233, 0.7);
    line-height: 1.6;
  }
  .rni-validation {
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    font-style: italic;
    color: rgba(201, 168, 76, 0.7);
    text-align: center;
    margin-top: 1rem;
  }

  /* ── CERT BAND ── */
  .cert-band {
    background: var(--dark-mid);
    border-top: 1px solid rgba(201, 168, 76, 0.15);
    border-bottom: 1px solid rgba(201, 168, 76, 0.15);
    padding: clamp(3rem, 7vw, 6rem) clamp(2rem, 5vw, 4rem);
    text-align: center;
  }
  .cert-label {
    font-family: "Cinzel", serif;
    font-size: clamp(0.75rem, 1.4vw, 0.88rem);
    letter-spacing: 0.38em;
    color: var(--gold);
    opacity: 0.8;
    margin-bottom: 0.8rem;
  }
  .cert-headline {
    font-family: "Cinzel", serif;
    font-size: clamp(1.1rem, 2.5vw, 1.7rem);
    font-weight: 600;
    color: var(--parchment);
    margin-bottom: 2rem;
    letter-spacing: 0.05em;
  }
  .cert-details {
    max-width: 700px;
    margin: 0 auto;
    border: 1px solid rgba(201, 168, 76, 0.2);
    background: rgba(201, 168, 76, 0.03);
  }
  .cert-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.4rem;
    border-bottom: 1px solid rgba(201, 168, 76, 0.1);
    gap: 1rem;
  }
  .cert-row:last-child {
    border-bottom: none;
  }
  .cert-key {
    font-family: "Cinzel", serif;
    font-size: clamp(0.68rem, 1.2vw, 0.8rem);
    letter-spacing: 0.2em;
    color: rgba(201, 168, 76, 0.6);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .cert-val {
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: var(--parchment);
    font-style: italic;
    text-align: right;
  }
  @media (max-width: 540px) {
    .cert-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
    .cert-key {
      white-space: normal;
    }
    .cert-val {
      text-align: left;
    }
  }

  /* ── CLOSING ── */
  .closing {
    text-align: center;
    padding: clamp(4rem, 10vw, 8rem) clamp(2rem, 5vw, 4rem);
    background: linear-gradient(to bottom, var(--dark-mid), var(--dark));
    position: relative;
    overflow: hidden;
  }
  .closing::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(201, 168, 76, 0.05) 0%, transparent 65%);
  }
  .closing-inner {
    position: relative;
    z-index: 1;
    max-width: 700px;
    margin: 0 auto;
  }
  .closing-main {
    font-family: "Cinzel", serif;
    font-size: clamp(1.5rem, 4.5vw, 3rem);
    font-weight: 400;
    color: var(--parchment);
    letter-spacing: 0.06em;
    line-height: 1.3;
    margin-bottom: 1.2rem;
  }
  .closing-main span {
    color: var(--gold);
  }
  .closing-sub {
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    font-style: italic;
    color: rgba(250, 245, 233, 0.65);
    line-height: 1.8;
    margin-bottom: 2.5rem;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }
</style>
