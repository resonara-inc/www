---
import "../styles/global.css";
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Ancient Frequency. Modern Proof." } = Astro.props;
const path = Astro.url.pathname;

const navLinks = [
  { href: "/science", label: "The Science" },
  { href: "/who-its-for", label: "Who It's For" },
  { href: "/partners", label: "Partners" },
  { href: "/story", label: "Our Story" },
  { href: "/roi-calculator", label: "ROI Calculator" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cinzel:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo">RESONARA</a>
      <div class="nav-links">
        {
          navLinks.map((link) => (
            <a href={link.href} class={path === link.href || (link.href !== "/" && path.startsWith(link.href)) ? "active" : ""}>
              {link.label}
            </a>
          ))
        }
      </div>
    </nav>

    <slot />

    <footer>
      <p>RESONARA &nbsp;·&nbsp; Ancient Frequency. Modern Proof. &nbsp;·&nbsp; resonara.com</p>
    </footer>

    <script>
      const selectors = ".reveal, .fade-up, .reveal-l, .reveal-r, .reveal-left, .reveal-right";
      const obs = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("visible");
              obs.unobserve(e.target);
            }
          }),
        { threshold: 0.08 },
      );
      document.querySelectorAll(selectors).forEach((el) => obs.observe(el));
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --gold: #c9a84c;
    --gold-light: #e8c97a;
    --gold-pale: #f5e9c8;
    --dark: #0e0c09;
    --dark-mid: #151209;
    --parchment: #faf5e9;
    /* Remap light-theme Tailwind vars to dark equivalents for DarkLayout pages */
    --background: #0e0c09;
    --foreground: #faf5e9;
    --card: #1a1610;
    --muted: #2a2318;
    --muted-foreground: #8a7a55;
    --border: rgba(201, 168, 76, 0.18);
    --accent: #c9a84c;
    --accent-foreground: #0e0c09;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--dark);
    color: var(--parchment);
    font-family: "Cormorant Garamond", Georgia, serif;
    overflow-x: hidden;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(14, 12, 9, 0.96);
    border-bottom: 1px solid rgba(201, 168, 76, 0.12);
  }
  .nav-logo {
    font-family: "Cinzel", serif;
    font-size: clamp(0.9rem, 2.5vw, 1.2rem);
    letter-spacing: 0.3em;
    color: var(--gold);
    text-decoration: none;
  }
  .nav-links {
    display: flex;
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
  }
  .nav-links a {
    font-family: "Cinzel", serif;
    font-size: clamp(0.6rem, 1.2vw, 0.75rem);
    letter-spacing: 0.25em;
    color: rgba(201, 168, 76, 0.6);
    text-decoration: none;
    transition: color 0.3s;
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: var(--gold);
  }
  @media (max-width: 700px) {
    .nav-links {
      display: none;
    }
  }

  /* ── FOOTER ── */
  footer {
    border-top: 1px solid rgba(201, 168, 76, 0.1);
    padding: 2rem 1.5rem;
    text-align: center;
  }
  footer p {
    font-family: "Cinzel", serif;
    font-size: clamp(0.65rem, 1.2vw, 0.82rem);
    letter-spacing: 0.25em;
    color: rgba(201, 168, 76, 0.35);
    line-height: 1.8;
  }

  /* ── ORNAMENT ── */
  .ornament {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    padding: 2rem;
  }
  .ornament::before,
  .ornament::after {
    content: "";
    flex: 1;
    max-width: 120px;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(201, 168, 76, 0.35));
  }
  .ornament::after {
    background: linear-gradient(to left, transparent, rgba(201, 168, 76, 0.35));
  }
  .ornament span {
    color: var(--gold);
    font-size: 1.1rem;
    opacity: 0.6;
  }

  /* ── SCROLL REVEAL ── */
  .reveal,
  .fade-up {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.9s ease,
      transform 0.9s ease;
  }
  .reveal.visible,
  .fade-up.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-l,
  .reveal-left {
    opacity: 0;
    transform: translateX(-28px);
    transition:
      opacity 1s ease,
      transform 1s ease;
  }
  .reveal-l.visible,
  .reveal-left.visible {
    opacity: 1;
    transform: translateX(0);
  }
  .reveal-r,
  .reveal-right {
    opacity: 0;
    transform: translateX(28px);
    transition:
      opacity 1s ease,
      transform 1s ease;
  }
  .reveal-r.visible,
  .reveal-right.visible {
    opacity: 1;
    transform: translateX(0);
  }
  @media (max-width: 800px) {
    .reveal-l,
    .reveal-r,
    .reveal-left,
    .reveal-right {
      transform: translateY(22px);
    }
    .reveal-l.visible,
    .reveal-r.visible,
    .reveal-left.visible,
    .reveal-right.visible {
      transform: translateY(0);
    }
  }
  .d1 {
    transition-delay: 0.1s;
  }
  .d2 {
    transition-delay: 0.22s;
  }
  .d3 {
    transition-delay: 0.34s;
  }
  .d4 {
    transition-delay: 0.46s;
  }

  /* ── CTA BUTTON ── */
  .cta-btn {
    display: inline-block;
    font-family: "Cinzel", serif;
    font-size: clamp(0.75rem, 1.4vw, 0.88rem);
    letter-spacing: 0.28em;
    color: var(--dark);
    background: var(--gold);
    padding: 1.1rem 2.4rem;
    text-decoration: none;
    border: 1px solid var(--gold);
    transition: all 0.35s ease;
    position: relative;
    overflow: hidden;
    white-space: nowrap;
  }
  .cta-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--gold-light);
    transform: translateX(-100%);
    transition: transform 0.4s ease;
  }
  .cta-btn:hover::before {
    transform: translateX(0);
  }
  .cta-btn span {
    position: relative;
    z-index: 1;
  }
  .cta-btn.outline {
    background: transparent;
    color: var(--gold);
  }
  .cta-btn.outline::before {
    background: rgba(201, 168, 76, 0.1);
  }

  /* ── SHARED TYPOGRAPHY ── */
  .section-label {
    font-family: "Cinzel", serif;
    font-size: clamp(0.7rem, 1.5vw, 0.85rem);
    letter-spacing: 0.4em;
    color: var(--gold);
    opacity: 0.8;
    margin-bottom: 1rem;
    text-align: center;
    text-transform: uppercase;
  }
  .section-heading {
    font-family: "Cinzel", serif;
    font-size: clamp(1.2rem, 2.8vw, 2rem);
    font-weight: 600;
    color: var(--parchment);
    letter-spacing: 0.05em;
    line-height: 1.35;
    margin-bottom: 1rem;
    text-align: center;
  }
  .section-heading span {
    color: var(--gold);
  }
  .section-sub {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-style: italic;
    color: rgba(250, 245, 233, 0.6);
    text-align: center;
    line-height: 1.8;
    margin-bottom: 3rem;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }
  .body-p {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    line-height: 1.95;
    color: rgba(250, 245, 233, 0.82);
    margin-bottom: 1.2rem;
  }
  .body-p em {
    font-style: italic;
    color: var(--gold-pale);
  }
  .body-p strong {
    font-weight: 600;
    color: var(--parchment);
  }
  .pull-quote {
    border-left: 2px solid var(--gold);
    padding: 1.2rem 1.6rem;
    margin: 1.6rem 0;
    background: rgba(201, 168, 76, 0.04);
  }
  .pull-quote p {
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-style: italic;
    color: var(--gold-pale);
    line-height: 1.8;
  }
  .pull-quote cite {
    display: block;
    margin-top: 0.8rem;
    font-family: "Cinzel", serif;
    font-size: clamp(0.65rem, 1.2vw, 0.78rem);
    letter-spacing: 0.3em;
    color: rgba(201, 168, 76, 0.55);
    font-style: normal;
  }
</style>
